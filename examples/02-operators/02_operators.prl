/*
* Sample 2: Operators
*/

import "io"

func main(){
    print("Example 2: Operators")

    let a = 10
    let b = 4

    print("Arithmetic with a=10, b=4")

    //Addition
    print("a+b= ")
    print(a+b)

    //Subtraction
    print("a-b= ")
    print(a-b)

    //Multiplication
    print("a*b= ")
    print(a*b)

    //Division
    print("a/b= ")
    print(a/b)

    //Modulo
    print("a%b=")
    print(a%b)

    // Comparision
    let x = 5
    let y = 5
    let z = 6
    print("Comparisons with x=5, y=5, z=6")
    print("x == y:")
    print(x == y) // true
    print("x != z:")
    print(x != z) // true
    print("x < z:")
    print(x < z)  // true
    print("z >= y:")
    print(z >= y) // true

    //Logical operators
    let isSunny = true
    let hasCoffee = false
    print("Logical Operators:")
    print("isSunny && hasCoffee (AND):")
    print(isSunny && hasCoffee) // false
    print("isSunny || hasCoffee (OR):")
    print(isSunny || hasCoffee)  // true
    print("!hasCoffee (NOT):")
    print(!hasCoffee) // true
}
