/*
 * Pixel editor tests — view.prl
 */

import "testing.prl"
import "../view.prl"

func test_view_run() : TestRun {
    let r: TestRun = t_new()

    let v: View = view_new(4)
    r = t_eq_int(r, "zoom is set", v.zoom, 4)
    r = t_eq_int(r, "pan starts at origin", v.panX, 0)

    r = t_eq_int(r, "zoom below the minimum is clamped", view_new(0).zoom, view_min_zoom())
    r = t_eq_int(r, "zoom above the maximum is clamped", view_new(999).zoom, view_max_zoom())

    // ── Transforms ───────────────────────────────────────────────────────────
    r = t_eq_int(r, "screen to image at the origin", view_to_image_x(v, 0), 0)
    r = t_eq_int(r, "screen to image within a cell", view_to_image_x(v, 3), 0)
    r = t_eq_int(r, "screen to image at the next cell", view_to_image_x(v, 4), 1)
    r = t_eq_int(r, "screen to image well inside", view_to_image_y(v, 9), 2)

    // Floor division, not truncation. A screen pixel one to the left of the image must map to
    // column -1 and be rejected, not fold back into column 0 and paint on the first column.
    r = t_eq_int(r, "screen to image just left of the origin", view_to_image_x(v, 0 - 1), 0 - 1)
    r = t_eq_int(r, "screen to image a full cell left", view_to_image_x(v, 0 - 4), 0 - 1)
    r = t_eq_int(r, "screen to image two cells left", view_to_image_x(v, 0 - 5), 0 - 2)

    r = t_eq_int(r, "image to screen at the origin", view_to_screen_x(v, 0), 0)
    r = t_eq_int(r, "image to screen scales by zoom", view_to_screen_x(v, 3), 12)

    // The two transforms must be inverses at cell boundaries, which is what keeps the brush under
    // the cursor. WinFormsHelper.CanvasSetView applies the same formula on the C# side.
    let roundTripFailures: int = 0
    let panned: View = view_pan_by(view_new(8), 3, 5)
    let i: int = 0 - 4
    while (i <= 12) {
        if (view_to_image_x(panned, view_to_screen_x(panned, i)) != i) {
            roundTripFailures = roundTripFailures + 1
        }
        if (view_to_image_y(panned, view_to_screen_y(panned, i)) != i) {
            roundTripFailures = roundTripFailures + 1
        }
        i = i + 1
    }
    r = t_eq_int(r, "transforms are inverses", roundTripFailures, 0)

    // ── Pan ──────────────────────────────────────────────────────────────────
    let moved: View = view_pan_by(v, 2, 3)
    r = t_eq_int(r, "pan shifts x", moved.panX, 2)
    r = t_eq_int(r, "pan shifts y", moved.panY, 3)
    r = t_eq_int(r, "pan offsets the mapping", view_to_image_x(moved, 0), 2)

    // ── Zoom about an anchor ─────────────────────────────────────────────────
    // The pixel under the cursor has to stay under it, or the area being worked on slides out of
    // view on every wheel notch.
    let anchored: View = view_new(4)
    let beforeX: int = view_to_image_x(anchored, 40)
    let beforeY: int = view_to_image_y(anchored, 40)

    let zoomedIn: View = view_zoom_in(anchored, 40, 40)
    r = t_eq_int(r, "zoom in doubles", zoomedIn.zoom, 8)
    r = t_eq_int(r, "anchor pixel is unchanged in x", view_to_image_x(zoomedIn, 40), beforeX)
    r = t_eq_int(r, "anchor pixel is unchanged in y", view_to_image_y(zoomedIn, 40), beforeY)

    let zoomedOut: View = view_zoom_out(zoomedIn, 40, 40)
    r = t_eq_int(r, "zoom out halves", zoomedOut.zoom, 4)
    r = t_eq_int(r, "anchor survives a round trip", view_to_image_x(zoomedOut, 40), beforeX)

    // Zoom is clamped, and a clamped zoom must not shift the pan.
    let atMax: View = view_new(view_max_zoom())
    let beyond: View = view_zoom_in(atMax, 10, 10)
    r = t_eq_int(r, "cannot zoom past the maximum", beyond.zoom, view_max_zoom())
    r = t_eq_int(r, "clamped zoom leaves pan alone", beyond.panX, atMax.panX)

    let atMin: View = view_new(view_min_zoom())
    r = t_eq_int(r, "cannot zoom below the minimum", view_zoom_out(atMin, 10, 10).zoom, view_min_zoom())

    // ── Grid ─────────────────────────────────────────────────────────────────
    r = t_false(r, "no grid at zoom 1", view_show_grid(view_new(1)))
    r = t_false(r, "no grid below the threshold", view_show_grid(view_new(view_grid_threshold() - 1)))
    r = t_true(r, "grid at the threshold", view_show_grid(view_new(view_grid_threshold())))
    r = t_true(r, "grid above the threshold", view_show_grid(view_new(16)))

    // ── Fit and centre ───────────────────────────────────────────────────────
    r = t_eq_int(r, "fit uses the tighter axis", view_fit_zoom(32, 16, 320, 160), 10)
    r = t_eq_int(r, "fit is limited by height", view_fit_zoom(16, 32, 320, 160), 5)
    r = t_eq_int(r, "fit clamps to the maximum", view_fit_zoom(1, 1, 4096, 4096), view_max_zoom())
    r = t_eq_int(r, "fit of an empty image", view_fit_zoom(0, 0, 100, 100), 1)

    // Centring a 10x10 image in a 20x20 cell area puts 5 cells of margin on each side, so the
    // pan is negative.
    let centred: View = view_centre(view_new(1), 10, 10, 20, 20)
    r = t_eq_int(r, "centre offsets x", centred.panX, 0 - 5)
    r = t_eq_int(r, "centre offsets y", centred.panY, 0 - 5)

    // ── Pan clamping ─────────────────────────────────────────────────────────
    let far: View = view_pan_by(view_new(4), 10000, 10000)
    let clamped: View = view_clamp_pan(far, 64, 64, 256, 256)
    r = t_eq_int(r, "pan cannot run past the image", clamped.panX, 64)

    let farBack: View = view_pan_by(view_new(4), 0 - 10000, 0 - 10000)
    let clampedBack: View = view_clamp_pan(farBack, 64, 64, 256, 256)
    r = t_eq_int(r, "pan cannot run off the other side", clampedBack.panX, 0 - 64)

    return r
}
