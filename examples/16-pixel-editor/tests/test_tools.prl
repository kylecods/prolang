/*
 * Pixel editor tests — tools.prl
 *
 * Each case drives the press / drag / release sequence the event loop would, so the tests cover
 * the state machine rather than the rasterisers underneath it.
 */

import "array"
import "testing"
import "../tools.prl"
import "ui/document"
import "ui/color"
import "ui/icons"

func test_tools_run() : void {
    let ink: int = color_rgb(255, 255, 255)
    let paper: int = color_rgb(0, 0, 0)
    let log: array<int> = array_new(8192)

    // ── Classification ───────────────────────────────────────────────────────
    t_true("pencil is direct", tool_is_direct(Tool.PENCIL))
    t_true("eraser is direct", tool_is_direct(Tool.ERASER))
    t_false("line is not direct", tool_is_direct(Tool.LINE))
    t_true("line is a shape", tool_is_shape(Tool.LINE))
    t_true("ellipse is a shape", tool_is_shape(Tool.ELLIPSE))
    t_false("fill is not a shape", tool_is_shape(Tool.FILL))
    t_false("picker is not a shape", tool_is_shape(Tool.PICKER))

    // The eraser paints transparency; every other tool paints the selected colour.
    t_eq_int("eraser paints transparent", tool_colour(Tool.ERASER, ink), 0)
    t_eq_int("pencil paints the colour", tool_colour(Tool.PENCIL, ink), ink)

    t_eq_str("pencil is named", tool_name(Tool.PENCIL), "pencil")
    t_eq_str("unknown tool is named", tool_name(99), "unknown")

    // ── Pencil ───────────────────────────────────────────────────────────────
    let doc: Document = Document->new(16, 16, paper)
    let preview: Document = doc->clone()
    let s: Stroke = stroke_new(Tool.PENCIL, ink, 1)

    s = tool_press(s, doc, preview, log, 2, 2)
    t_true("press starts a drag", s.active)
    t_eq_int("press paints immediately", doc->get(2, 2), ink)

    // A drag draws a line from the last position, not a dot at the new one: the mouse reports
    // discrete positions and a fast movement would otherwise leave gaps.
    s = tool_drag(s, doc, preview, log, 6, 2)
    t_eq_int("drag fills the gap", doc->get(4, 2), ink)
    t_eq_int("drag reaches the new point", doc->get(6, 2), ink)
    t_eq_int("drag records the new position", s.lastX, 6)
    t_false("a drag does not ask for a snapshot", s.commit)

    s = tool_release(s, doc, preview, log, 6, 2)
    t_false("release ends the drag", s.active)
    t_true("release asks for a snapshot", s.commit)

    // ── Eraser ───────────────────────────────────────────────────────────────
    let erased: Document = Document->new(8, 8, ink)
    let erasedPreview: Document = erased->clone()
    let e: Stroke = stroke_new(Tool.ERASER, ink, 1)

    e = tool_press(e, erased, erasedPreview, log, 3, 3)
    t_eq_int("eraser clears a pixel", erased->get(3, 3), 0)
    t_eq_int("eraser leaves its neighbour", erased->get(4, 3), ink)

    // ── Picker ───────────────────────────────────────────────────────────────
    let sampled: Document = Document->new(8, 8, paper)
    sampled->set(5, 5, ink)
    let p: Stroke = stroke_new(Tool.PICKER, paper, 1)

    p = tool_press(p, sampled, preview, log, 5, 5)
    t_eq_int("picker reports the colour", p.picked, ink)
    t_false("picker starts no drag", p.active)
    t_false("picker changes nothing to undo", p.commit)
    t_eq_int("picker leaves the image alone", sampled->get(5, 5), ink)

    // ── Fill ─────────────────────────────────────────────────────────────────
    let bucket: Document = Document->new(4, 4, paper)
    let f: Stroke = stroke_new(Tool.FILL, ink, 1)

    f = tool_press(f, bucket, preview, log, 0, 0)
    t_eq_int("fill covers the region", bucket->count_colour(ink), 16)
    t_true("fill asks for a snapshot", f.commit)
    t_false("fill starts no drag", f.active)

    // A fill that changes nothing must not ask for a snapshot, or undo fills with duplicates.
    let already: Stroke = stroke_new(Tool.FILL, ink, 1)
    already = tool_press(already, bucket, preview, log, 0, 0)
    t_false("a fill that changed nothing skips the snapshot", already.commit)

    // ── Shape preview ────────────────────────────────────────────────────────
    // The document must not change until release; only the preview does.
    let shapeDoc: Document = Document->new(16, 16, paper)
    let shapePreview: Document = shapeDoc->clone()
    let baseline: Document = shapeDoc->clone()
    let line: Stroke = stroke_new(Tool.LINE, ink, 1)

    line = tool_press(line, shapeDoc, shapePreview, log, 1, 1)
    t_true("shape press starts a drag", line.active)
    t_true("shape press leaves the document alone", shapeDoc->equals(baseline))

    line = tool_drag(line, shapeDoc, shapePreview, log, 10, 1)
    t_true("shape drag still leaves the document alone", shapeDoc->equals(baseline))
    t_false("shape drag updates the preview", shapePreview->equals(baseline))
    t_true("shape drag records what it touched", line.touched > 0)
    t_eq_int("preview shows the line", shapePreview->get(5, 1), ink)

    // Dragging elsewhere must rewind the previous preview completely, using the touch log. A
    // stale pixel left behind here is the classic rubber-banding bug.
    line = tool_drag(line, shapeDoc, shapePreview, log, 1, 10)
    t_eq_int("old preview pixel is rewound", shapePreview->get(5, 1), paper)
    t_eq_int("new preview pixel is drawn", shapePreview->get(1, 5), ink)

    line = tool_release(line, shapeDoc, shapePreview, log, 1, 10)
    t_false("shape release ends the drag", line.active)
    t_true("shape release asks for a snapshot", line.commit)
    t_eq_int("release commits to the document", shapeDoc->get(1, 5), ink)
    t_true("preview matches the document after release", shapePreview->equals(shapeDoc))

    // ── Cancelling a shape ───────────────────────────────────────────────────
    let cancelDoc: Document = Document->new(16, 16, paper)
    let cancelPreview: Document = cancelDoc->clone()
    let cancelBase: Document = cancelDoc->clone()
    let rect: Stroke = stroke_new(Tool.RECT, ink, 1)

    rect = tool_press(rect, cancelDoc, cancelPreview, log, 2, 2)
    rect = tool_drag(rect, cancelDoc, cancelPreview, log, 9, 9)
    rect = tool_cancel(rect, cancelDoc, cancelPreview, log)

    t_false("cancel ends the drag", rect.active)
    t_false("cancel does not ask for a snapshot", rect.commit)
    t_true("cancel rewinds the preview", cancelPreview->equals(cancelBase))
    t_true("cancel leaves the document alone", cancelDoc->equals(cancelBase))

    // A drag or release without a press must do nothing.
    let idle: Stroke = stroke_new(Tool.PENCIL, ink, 1)
    let idleDoc: Document = Document->new(8, 8, paper)
    let idleBase: Document = idleDoc->clone()

    idle = tool_drag(idle, idleDoc, preview, log, 4, 4)
    t_true("drag without press does nothing", idleDoc->equals(idleBase))
    idle = tool_release(idle, idleDoc, preview, log, 4, 4)
    t_false("release without press asks for nothing", idle.commit)

    // ── Selection changes ────────────────────────────────────────────────────
    let sel: Stroke = stroke_new(Tool.PENCIL, ink, 3)
    t_eq_int("tool change takes effect", stroke_with_tool(sel, Tool.LINE).tool, Tool.LINE)
    t_false("tool change ends any drag", stroke_with_tool(sel, Tool.LINE).active)
    t_eq_int("colour change takes effect", stroke_with_colour(sel, paper).colour, paper)
    t_eq_int("size change takes effect", stroke_with_size(sel, 5).size, 5)
    t_eq_int("size is clamped low", stroke_with_size(sel, 0).size, 1)
    t_eq_int("size is clamped high", stroke_with_size(sel, 999).size, 16)

    // ── The icon each tool shows ─────────────────────────────────────────────
    /*
     * This mapping is the editor's, not the library's: `ui/icons` draws a pencil without knowing
     * that this program has a pencil tool. So it is checked here, where it lives.
     *
     * No two tools may share an icon — a duplicate would put the same picture on two toolbar
     * buttons — and every one must be a real icon rather than an index off the end of the set,
     * which is what a tool added without a case in tool_icon would produce.
     */
    let icons: array<int> = array_new(tool_count())
    let inRange: int = 0
    let t: int = 0

    while (t < tool_count()) {
        icons[t] = tool_icon(t)
        if (icons[t] >= 0 && icons[t] < icon_count()) {
            inRange = inRange + 1
        }
        t = t + 1
    }

    t_eq_int("every tool maps to a real icon", inRange, tool_count())

    let duplicates: int = 0
    let a: int = 0
    while (a < tool_count()) {
        let b: int = a + 1
        while (b < tool_count()) {
            if (icons[a] == icons[b]) {
                duplicates = duplicates + 1
            }
            b = b + 1
        }
        a = a + 1
    }
    t_eq_int("each tool has its own icon", duplicates, 0)
}
