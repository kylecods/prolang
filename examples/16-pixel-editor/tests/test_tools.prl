/*
 * Pixel editor tests — tools.prl
 *
 * Each case drives the press / drag / release sequence the event loop would, so the tests cover
 * the state machine rather than the rasterisers underneath it.
 */

import "testing.prl"
import "../tools.prl"
import "../document.prl"
import "../color.prl"

func test_tools_run() : TestRun {
    let r: TestRun = t_new()

    let ink: int = color_rgb(255, 255, 255)
    let paper: int = color_rgb(0, 0, 0)
    let log: array<int> = array_new(8192)

    // ── Classification ───────────────────────────────────────────────────────
    r = t_true(r, "pencil is direct", tool_is_direct(Tool.PENCIL))
    r = t_true(r, "eraser is direct", tool_is_direct(Tool.ERASER))
    r = t_false(r, "line is not direct", tool_is_direct(Tool.LINE))
    r = t_true(r, "line is a shape", tool_is_shape(Tool.LINE))
    r = t_true(r, "ellipse is a shape", tool_is_shape(Tool.ELLIPSE))
    r = t_false(r, "fill is not a shape", tool_is_shape(Tool.FILL))
    r = t_false(r, "picker is not a shape", tool_is_shape(Tool.PICKER))

    // The eraser paints transparency; every other tool paints the selected colour.
    r = t_eq_int(r, "eraser paints transparent", tool_colour(Tool.ERASER, ink), 0)
    r = t_eq_int(r, "pencil paints the colour", tool_colour(Tool.PENCIL, ink), ink)

    r = t_eq_str(r, "pencil is named", tool_name(Tool.PENCIL), "pencil")
    r = t_eq_str(r, "unknown tool is named", tool_name(99), "unknown")

    // ── Pencil ───────────────────────────────────────────────────────────────
    let doc: Document = doc_new(16, 16, paper)
    let preview: Document = doc_clone(doc)
    let s: Stroke = stroke_new(Tool.PENCIL, ink, 1)

    s = tool_press(s, doc, preview, log, 2, 2)
    r = t_true(r, "press starts a drag", s.active)
    r = t_eq_int(r, "press paints immediately", doc_get(doc, 2, 2), ink)

    // A drag draws a line from the last position, not a dot at the new one: the mouse reports
    // discrete positions and a fast movement would otherwise leave gaps.
    s = tool_drag(s, doc, preview, log, 6, 2)
    r = t_eq_int(r, "drag fills the gap", doc_get(doc, 4, 2), ink)
    r = t_eq_int(r, "drag reaches the new point", doc_get(doc, 6, 2), ink)
    r = t_eq_int(r, "drag records the new position", s.lastX, 6)
    r = t_false(r, "a drag does not ask for a snapshot", s.commit)

    s = tool_release(s, doc, preview, log, 6, 2)
    r = t_false(r, "release ends the drag", s.active)
    r = t_true(r, "release asks for a snapshot", s.commit)

    // ── Eraser ───────────────────────────────────────────────────────────────
    let erased: Document = doc_new(8, 8, ink)
    let erasedPreview: Document = doc_clone(erased)
    let e: Stroke = stroke_new(Tool.ERASER, ink, 1)

    e = tool_press(e, erased, erasedPreview, log, 3, 3)
    r = t_eq_int(r, "eraser clears a pixel", doc_get(erased, 3, 3), 0)
    r = t_eq_int(r, "eraser leaves its neighbour", doc_get(erased, 4, 3), ink)

    // ── Picker ───────────────────────────────────────────────────────────────
    let sampled: Document = doc_new(8, 8, paper)
    doc_set(sampled, 5, 5, ink)
    let p: Stroke = stroke_new(Tool.PICKER, paper, 1)

    p = tool_press(p, sampled, preview, log, 5, 5)
    r = t_eq_int(r, "picker reports the colour", p.picked, ink)
    r = t_false(r, "picker starts no drag", p.active)
    r = t_false(r, "picker changes nothing to undo", p.commit)
    r = t_eq_int(r, "picker leaves the image alone", doc_get(sampled, 5, 5), ink)

    // ── Fill ─────────────────────────────────────────────────────────────────
    let bucket: Document = doc_new(4, 4, paper)
    let f: Stroke = stroke_new(Tool.FILL, ink, 1)

    f = tool_press(f, bucket, preview, log, 0, 0)
    r = t_eq_int(r, "fill covers the region", doc_count_colour(bucket, ink), 16)
    r = t_true(r, "fill asks for a snapshot", f.commit)
    r = t_false(r, "fill starts no drag", f.active)

    // A fill that changes nothing must not ask for a snapshot, or undo fills with duplicates.
    let already: Stroke = stroke_new(Tool.FILL, ink, 1)
    already = tool_press(already, bucket, preview, log, 0, 0)
    r = t_false(r, "a fill that changed nothing skips the snapshot", already.commit)

    // ── Shape preview ────────────────────────────────────────────────────────
    // The document must not change until release; only the preview does.
    let shapeDoc: Document = doc_new(16, 16, paper)
    let shapePreview: Document = doc_clone(shapeDoc)
    let baseline: Document = doc_clone(shapeDoc)
    let line: Stroke = stroke_new(Tool.LINE, ink, 1)

    line = tool_press(line, shapeDoc, shapePreview, log, 1, 1)
    r = t_true(r, "shape press starts a drag", line.active)
    r = t_true(r, "shape press leaves the document alone", doc_equals(shapeDoc, baseline))

    line = tool_drag(line, shapeDoc, shapePreview, log, 10, 1)
    r = t_true(r, "shape drag still leaves the document alone", doc_equals(shapeDoc, baseline))
    r = t_false(r, "shape drag updates the preview", doc_equals(shapePreview, baseline))
    r = t_true(r, "shape drag records what it touched", line.touched > 0)
    r = t_eq_int(r, "preview shows the line", doc_get(shapePreview, 5, 1), ink)

    // Dragging elsewhere must rewind the previous preview completely, using the touch log. A
    // stale pixel left behind here is the classic rubber-banding bug.
    line = tool_drag(line, shapeDoc, shapePreview, log, 1, 10)
    r = t_eq_int(r, "old preview pixel is rewound", doc_get(shapePreview, 5, 1), paper)
    r = t_eq_int(r, "new preview pixel is drawn", doc_get(shapePreview, 1, 5), ink)

    line = tool_release(line, shapeDoc, shapePreview, log, 1, 10)
    r = t_false(r, "shape release ends the drag", line.active)
    r = t_true(r, "shape release asks for a snapshot", line.commit)
    r = t_eq_int(r, "release commits to the document", doc_get(shapeDoc, 1, 5), ink)
    r = t_true(r, "preview matches the document after release", doc_equals(shapePreview, shapeDoc))

    // ── Cancelling a shape ───────────────────────────────────────────────────
    let cancelDoc: Document = doc_new(16, 16, paper)
    let cancelPreview: Document = doc_clone(cancelDoc)
    let cancelBase: Document = doc_clone(cancelDoc)
    let rect: Stroke = stroke_new(Tool.RECT, ink, 1)

    rect = tool_press(rect, cancelDoc, cancelPreview, log, 2, 2)
    rect = tool_drag(rect, cancelDoc, cancelPreview, log, 9, 9)
    rect = tool_cancel(rect, cancelDoc, cancelPreview, log)

    r = t_false(r, "cancel ends the drag", rect.active)
    r = t_false(r, "cancel does not ask for a snapshot", rect.commit)
    r = t_true(r, "cancel rewinds the preview", doc_equals(cancelPreview, cancelBase))
    r = t_true(r, "cancel leaves the document alone", doc_equals(cancelDoc, cancelBase))

    // A drag or release without a press must do nothing.
    let idle: Stroke = stroke_new(Tool.PENCIL, ink, 1)
    let idleDoc: Document = doc_new(8, 8, paper)
    let idleBase: Document = doc_clone(idleDoc)

    idle = tool_drag(idle, idleDoc, preview, log, 4, 4)
    r = t_true(r, "drag without press does nothing", doc_equals(idleDoc, idleBase))
    idle = tool_release(idle, idleDoc, preview, log, 4, 4)
    r = t_false(r, "release without press asks for nothing", idle.commit)

    // ── Selection changes ────────────────────────────────────────────────────
    let sel: Stroke = stroke_new(Tool.PENCIL, ink, 3)
    r = t_eq_int(r, "tool change takes effect", stroke_with_tool(sel, Tool.LINE).tool, Tool.LINE)
    r = t_false(r, "tool change ends any drag", stroke_with_tool(sel, Tool.LINE).active)
    r = t_eq_int(r, "colour change takes effect", stroke_with_colour(sel, paper).colour, paper)
    r = t_eq_int(r, "size change takes effect", stroke_with_size(sel, 5).size, 5)
    r = t_eq_int(r, "size is clamped low", stroke_with_size(sel, 0).size, 1)
    r = t_eq_int(r, "size is clamped high", stroke_with_size(sel, 999).size, 16)

    return r
}
