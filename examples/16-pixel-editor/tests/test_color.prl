/*
 * Pixel editor tests — color.prl
 */

import "testing.prl"
import "../color.prl"

func test_color_run() : TestRun {
    let r: TestRun = t_new()

    let opaqueRed: int = color_argb(255, 220, 50, 47)

    r = t_eq_int(r, "alpha round-trip", color_a(opaqueRed), 255)
    r = t_eq_int(r, "red round-trip", color_r(opaqueRed), 220)
    r = t_eq_int(r, "green round-trip", color_g(opaqueRed), 50)
    r = t_eq_int(r, "blue round-trip", color_b(opaqueRed), 47)

    // An alpha above 127 sets the sign bit, so a fully opaque colour is a negative int. That is
    // the correct bit pattern and the unpackers must still read it, which is what this checks.
    r = t_true(r, "opaque colour is negative", opaqueRed < 0)

    let translucent: int = color_argb(64, 1, 2, 3)
    r = t_true(r, "low alpha colour is positive", translucent > 0)
    r = t_eq_int(r, "low alpha round-trip", color_a(translucent), 64)

    // Channels are masked, not validated: prolang cannot report an error, and wrapping one
    // channel is better than letting it overflow into the next.
    r = t_eq_int(r, "channel over 255 is masked", color_r(color_argb(255, 256, 0, 0)), 0)
    r = t_eq_int(r, "channel does not bleed", color_g(color_argb(255, 256, 7, 0)), 7)

    r = t_eq_int(r, "rgb implies opaque", color_a(color_rgb(1, 2, 3)), 255)

    r = t_true(r, "zero is transparent", color_is_transparent(0))
    r = t_false(r, "opaque is not transparent", color_is_transparent(opaqueRed))

    let dimmed: int = color_with_alpha(opaqueRed, 128)
    r = t_eq_int(r, "with_alpha sets alpha", color_a(dimmed), 128)
    r = t_eq_int(r, "with_alpha keeps red", color_r(dimmed), 220)
    r = t_eq_int(r, "with_alpha keeps blue", color_b(dimmed), 47)

    r = t_eq_int(r, "luma of black", color_luma(color_rgb(0, 0, 0)), 0)
    r = t_eq_int(r, "luma of white", color_luma(color_rgb(255, 255, 255)), 255)
    r = t_true(r, "green reads brighter than blue",
               color_luma(color_rgb(0, 255, 0)) > color_luma(color_rgb(0, 0, 255)))

    r = t_eq_str(r, "hex digit low", color_hex_digit(0), "0")
    r = t_eq_str(r, "hex digit high", color_hex_digit(15), "F")
    r = t_eq_str(r, "hex byte pads", color_hex_byte(5), "05")
    r = t_eq_str(r, "hex byte full", color_hex_byte(255), "FF")
    r = t_eq_str(r, "hex of red", color_hex(color_rgb(220, 50, 47)), "#DC322F")
    r = t_eq_str(r, "hex of black", color_hex(color_rgb(0, 0, 0)), "#000000")

    return r
}
