/*
 * The rotating cube on Windows Forms.
 *
 * The point of this file is that it exists at all. `cube.prl` was written for a PlayStation
 * Portable, names no platform, and draws nothing — it only appends display-list records. So it runs
 * here unchanged, and the cube can be looked at, resized and clicked on a desktop long before
 * anyone finds a PSP to try it on.
 *
 * Compare it with psp_cube.prl: the scene, the buttons and the click handling are the same. The
 * host differs, and nothing else does.
 */

import "ui/host_winforms"
import "ui/theme"
import "ui/fps"
import "cube.prl"

enum CubeAct {
    NONE,
    ROT_XP,
    ROT_XM,
    ROT_YP,
    ROT_YM,
    ROT_ZP,
    ROT_ZM,
    RESET,
    SPIN,
    QUIT
}

func cube_scene_tag() : int {
    return 1
}

func cube_step() : int {
    return 4
}

// The painter's state: angles, colour, sine table and projection scratch, in one array. It has to
// be an array rather than locals because a function value captures nothing, so the painter reaches
// its state only through what it is passed. It is a global rather than a local of main for the
// same reason: the painter is invoked from inside the host, and a global is the one thing both
// sides can see.
global state: array<int> = cube_state_new()

// Whether the cube is auto-spinning. Was a one-element array for the same reason.
global spinning: int = 1

func main()
{
    let theme: int = Theme.MIDNIGHT

    cube_set_angles(state, 30, 40, 0)
    cube_set_colour(state, theme_accent(theme))

    let host: Host = hostw_open("ProLang Cube", 560, 420,
        background: theme_background(theme))

    hostw_min_size(host, 420, 320)

    let fonts: FontSet = hostw_font("Segoe UI", 10)
    let ui: Ui = ui_new(256)
    let frames: Fps = Fps->new()

    while (hostw_running(host)) {
        // Counted at the top of the loop, so a frame is measured from one build to the next —
        // input, layout, the scene and the paint submission all included.
        frames->tick()

        if (spinning == 1) {
            cube_turn_by(state, 1, 2, 0)
        }

        /*
         * How long to wait for input before drawing anyway.
         *
         * The default of 16ms is right for an interface that only changes when someone touches it:
         * it costs nothing while nothing is happening. An animation has something to draw every
         * frame, so waiting for an event that is not coming is just a cap on the frame rate — and
         * the counter above is what made that visible, since it read 40 rather than 60.
         */
        let wait: int = 16
        if (spinning == 1) {
            wait = 1
        }

        hostw_begin(host, ui, wait)

        ui_col(ui, pad: 12, gap: 10, bg: theme_background(theme))

            ui_row(ui)
                ui_text(ui, "X " + state[CubeS.ANG_X]
                          + "   Y " + state[CubeS.ANG_Y]
                          + "   Z " + state[CubeS.ANG_Z],
                        fg: theme_text_dim(theme))

                ui_spacer(ui, flex: 1)

                ui_text(ui, frames->text_detailed(), fg: theme_text_dim(theme))
            ui_end(ui)

            // The scene is a widget like any other: it takes the leftover space, sits inside a
            // card with a rounded background, and follows the window when it is resized.
            ui_scene(ui, tag: cube_scene_tag(), flex: 1, pad: 8, radius: 8,
                     bg: theme_surface(theme))

            ui_row(ui, gap: 6)
                cube_btn(ui, "X-", CubeAct.ROT_XM, theme)
                cube_btn(ui, "X+", CubeAct.ROT_XP, theme)
                cube_btn(ui, "Y-", CubeAct.ROT_YM, theme)
                cube_btn(ui, "Y+", CubeAct.ROT_YP, theme)
                cube_btn(ui, "Z-", CubeAct.ROT_ZM, theme)
                cube_btn(ui, "Z+", CubeAct.ROT_ZP, theme)
                ui_spacer(ui, flex: 1)
                cube_btn(ui, "Spin", CubeAct.SPIN, theme)
                cube_btn(ui, "Reset", CubeAct.RESET, theme)
                cube_btn(ui, "Quit", CubeAct.QUIT, theme)
            ui_end(ui)

        ui_end(ui)

        let act: int = hostw_present_scene(host, ui, fonts, cube_paint, state)

        let step: int = cube_step()

        if (act == CubeAct.ROT_XP) {
            cube_turn_by(state, step, 0, 0)
        } elif (act == CubeAct.ROT_XM) {
            cube_turn_by(state, 0 - step, 0, 0)
        } elif (act == CubeAct.ROT_YP) {
            cube_turn_by(state, 0, step, 0)
        } elif (act == CubeAct.ROT_YM) {
            cube_turn_by(state, 0, 0 - step, 0)
        } elif (act == CubeAct.ROT_ZP) {
            cube_turn_by(state, 0, 0, step)
        } elif (act == CubeAct.ROT_ZM) {
            cube_turn_by(state, 0, 0, 0 - step)
        } elif (act == CubeAct.RESET) {
            cube_set_angles(state, 0, 0, 0)
        } elif (act == CubeAct.SPIN) {
            spinning = 1 - spinning
        } elif (act == CubeAct.QUIT) {
            hostw_close(host)
        }
    }
}

func cube_btn(ui: Ui, label: string, action: int, theme: int) : int {
    return ui_button(ui, label,
        action: action,
        bg: theme_surface(theme),
        fg: theme_text(theme),
        radius: 6,
        pad: 8)
}
