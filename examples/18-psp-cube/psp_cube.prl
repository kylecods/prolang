/*
 * PSP rotating cube with UI controls.
 *
 * A wireframe cube rendered with psp_draw_line in the centre of the screen,
 * with the widget toolkit providing rotation buttons at the bottom.
 *
 * D-pad moves the cursor, Cross clicks a button, Start quits.
 * D-pad also rotates X/Y directly; L/R triggers rotate Z.
 *
 * Build with:
 *     prolang examples/18-psp-cube/psp_cube.prl --emit-psp
 *     make -f Makefile.psp
 */

import "psp"
import "ui/host_psp"
import "ui/theme"
import "ui/box"
import "ui/hit"
import "ui/draw"

// ── Actions for the UI buttons ───────────────────────────────────────────────
enum CubeAct {
    NONE,
    ROT_XP,
    ROT_XM,
    ROT_YP,
    ROT_YM,
    ROT_ZP,
    ROT_ZM,
    RESET
}

