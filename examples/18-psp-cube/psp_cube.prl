// ── Fixed-point math ─────────────────────────────────────────────────────────
// Scale factor: 12 fractional bits (values divided by 4096 after multiply).

func fp_mul(a: int, b: int) : int {
    return (a * b) / 4096
}

// ── Sine/cosine lookup ───────────────────────────────────────────────────────
// angle a is in [0, 255], mapping to 0..2pi.
// 4096 = sin(90deg).

func cube_sin(sinTbl: array<int>, a: int) : int {
    return sinTbl[a & 255]
}

func cube_cos(sinTbl: array<int>, a: int) : int {
    return cube_sin(sinTbl, a + 64)
}

// ── Rotation and projection ──────────────────────────────────────────────────
// A vertex slot holds (x, y). We project all 8 vertices once, then draw edges
// between the projected positions.

func project_vertices(sinTbl: array<int>, out: array<int>,
                      angX: int, angY: int, angZ: int,
                      cx: int, cy: int, scale: int, dist: int) : void {
    let cosY: int = cube_cos(sinTbl, angY)
    let sinY: int = cube_sin(sinTbl, angY)
    let cosX: int = cube_cos(sinTbl, angX)
    let sinX: int = cube_sin(sinTbl, angX)
    let cosZ: int = cube_cos(sinTbl, angZ)
    let sinZ: int = cube_sin(sinTbl, angZ)

    let i: int = 0
    while (i < 8) {
        // Unit cube vertex
        let vx: int = 0 - 1
        let vy: int = 0 - 1
        let vz: int = 0 - 1

        if (i == 0)      { vx = -1  vy = -1  vz = -1 }
        elif (i == 1)    { vx = -1  vy = -1  vz =  1 }
        elif (i == 2)    { vx = -1  vy =  1  vz = -1 }
        elif (i == 3)    { vx = -1  vy =  1  vz =  1 }
        elif (i == 4)    { vx =  1  vy = -1  vz = -1 }
        elif (i == 5)    { vx =  1  vy = -1  vz =  1 }
        elif (i == 6)    { vx =  1  vy =  1  vz = -1 }
        elif (i == 7)    { vx =  1  vy =  1  vz =  1 }

        // Rotate around Y
        let rx: int  = fp_mul(vx, cosY) + fp_mul(vz, sinY)
        let rz: int  = fp_mul(vx, 0 - sinY) + fp_mul(vz, cosY)

        // Rotate around X
        let ry: int  = fp_mul(vy, cosX) - fp_mul(rz, sinX)
        let rz2: int = fp_mul(vy, sinX) + fp_mul(rz, cosX)

        // Rotate around Z
        let rx2: int = fp_mul(rx, cosZ) - fp_mul(ry, sinZ)
        let ry2: int = fp_mul(rx, sinZ) + fp_mul(ry, cosZ)

        // Perspective projection
        let d: int = rz2 + dist
        if (d < 1) {
            d = 1
        }

        let sx: int = cx + ((rx2 * scale) / d)
        let sy: int = cy - ((ry2 * scale) / d)

        out[i * 2] = sx
        out[i * 2 + 1] = sy

        i = i + 1
    }
}

// ── Drawing ──────────────────────────────────────────────────────────────────

func draw_cube(proj: array<int>, color: int) : void {
    let e: int = 0
    while (e < 12) {
        let v0: int = 0
        let v1: int = 0

        // 12 edges of a cube: front face (4), back face (4), connecting (4)
        if (e == 0)      { v0 = 0  v1 = 1 }
        elif (e == 1)    { v0 = 1  v1 = 3 }
        elif (e == 2)    { v0 = 3  v1 = 2 }
        elif (e == 3)    { v0 = 2  v1 = 0 }
        elif (e == 4)    { v0 = 4  v1 = 5 }
        elif (e == 5)    { v0 = 5  v1 = 7 }
        elif (e == 6)    { v0 = 7  v1 = 6 }
        elif (e == 7)    { v0 = 6  v1 = 4 }
        elif (e == 8)    { v0 = 0  v1 = 4 }
        elif (e == 9)    { v0 = 1  v1 = 5 }
        elif (e == 10)   { v0 = 2  v1 = 6 }
        elif (e == 11)   { v0 = 3  v1 = 7 }

        let x1: int = proj[v0 * 2]
        let y1: int = proj[v0 * 2 + 1]
        let x2: int = proj[v1 * 2]
        let y2: int = proj[v1 * 2 + 1]

        psp_draw_line(x1, y1, x2, y2, color)
        e = e + 1
    }
}

// ── Angle helpers ────────────────────────────────────────────────────────────

func angle_wrap(a: int) : int {
    let r: int = a % 256
    if (r < 0) {
        return r + 256
    }
    return r
}

func angle_step_size() : int {
    return 4
}

// ── Main ─────────────────────────────────────────────────────────────────────

func main() {
    let sinTbl: array<int> = sin_table()
    let proj: array<int> = array_new(16)

    // Mutable angle state in single-element arrays so they survive copies.
    let angX: array<int> = array_new(1)
    let angY: array<int> = array_new(1)
    let angZ: array<int> = array_new(1)

    angX[0] = 30
    angY[0] = 40
    angZ[0] = 0

    let theme: int = Theme.MIDNIGHT

    let host: PspHost = hostp_open(512)
    let fonts: FontSet = hostp_fonts()
    let ui: Ui = ui_new(256)

    let cx: int = hostp_width() / 2
    let cy: int = (hostp_height() / 2) - 12
    let projScale: int = 800
    let projDist: int = 14

    while (hostp_running(host)) {
        hostp_begin(host, ui)

        // Direct D-pad / L/R input for continuous rotation
        let held: int = psp_buttons_held()
        let step: int = angle_step_size()

        if ((held & PspPad.LEFT) != 0) {
            angY[0] = angY[0] - step
        }
        if ((held & PspPad.RIGHT) != 0) {
            angY[0] = angY[0] + step
        }
        if ((held & PspPad.UP) != 0) {
            angX[0] = angX[0] - step
        }
        if ((held & PspPad.DOWN) != 0) {
            angX[0] = angX[0] + step
        }
        if ((held & PspPad.LTRIGGER) != 0) {
            angZ[0] = angZ[0] - step
        }
        if ((held & PspPad.RTRIGGER) != 0) {
            angZ[0] = angZ[0] + step
        }

        angX[0] = angle_wrap(angX[0])
        angY[0] = angle_wrap(angY[0])
        angZ[0] = angle_wrap(angZ[0])

        // ── Build UI tree ──────────────────────────────────────────────
        ui_col(ui, pad: 6, gap: 4)

            ui_text(ui, "X:" + angX[0] + "  Y:" + angY[0] + "  Z:" + angZ[0],
                fg: theme_text_dim(theme))

            ui_spacer(ui, flex: 1)

            // Row 1: X and Y rotation
            ui_row(ui, gap: 4)
                cube_btn(ui, "X-", CubeAct.ROT_XM, theme)
                cube_btn(ui, "X+", CubeAct.ROT_XP, theme)
                cube_btn(ui, "Y-", CubeAct.ROT_YM, theme)
                cube_btn(ui, "Y+", CubeAct.ROT_YP, theme)
            ui_end(ui)

            // Row 2: Z rotation and reset
            ui_row(ui, gap: 4)
                cube_btn(ui, "Z-", CubeAct.ROT_ZM, theme)
                cube_btn(ui, "Z+", CubeAct.ROT_ZP, theme)
                ui_spacer(ui, flex: 1)
                cube_btn(ui, "Reset", CubeAct.RESET, theme)
            ui_end(ui)

            ui_text(ui, "D-pad X/Y  |  L/R Z  |  Start quits",
                fg: theme_text_dim(theme))

        ui_end(ui)

        // ── Layout, hit test, build display list ──────────────────────
        let root: int = ui_root(ui)
        let fired: int = 0

        if (root >= 0) {
            box_layout(ui, fonts, root, 0, 0, hostp_width(), hostp_height())
            fired = hit_resolve(ui)
        }

        // ── Custom rendering: cube behind UI ──────────────────────────
        psp_clear(hostp_rgb(theme_background(theme)))

        project_vertices(sinTbl, proj, angX[0], angY[0], angZ[0],
            cx, cy, projScale, projDist)

        draw_cube(proj, theme_accent(theme))

        // Draw UI on top
        if (root >= 0) {
            let count: int = dl_build(ui, fonts, root, host.ops)
            hostp_execute(host, ui, count)
        }

        hostp_draw_cursor(host)
        psp_swap_buffers()

        // ── Handle button clicks ──────────────────────────────────────
        if (fired == CubeAct.ROT_XP) {
            angX[0] = angle_wrap(angX[0] + step)
        } elif (fired == CubeAct.ROT_XM) {
            angX[0] = angle_wrap(angX[0] - step)
        } elif (fired == CubeAct.ROT_YP) {
            angY[0] = angle_wrap(angY[0] + step)
        } elif (fired == CubeAct.ROT_YM) {
            angY[0] = angle_wrap(angY[0] - step)
        } elif (fired == CubeAct.ROT_ZP) {
            angZ[0] = angle_wrap(angZ[0] + step)
        } elif (fired == CubeAct.ROT_ZM) {
            angZ[0] = angle_wrap(angZ[0] - step)
        } elif (fired == CubeAct.RESET) {
            angX[0] = 0
            angY[0] = 0
            angZ[0] = 0
        }
    }
}

// ── Button component ─────────────────────────────────────────────────────────

func cube_btn(ui: Ui, label: string, action: int, theme: int) : int {
    return ui_button(ui, label,
        action: action,
        bg: theme_surface(theme),
        fg: theme_text(theme),
        radius: 4,
        pad: 5)
}