/*
 * The rotating cube on a PlayStation Portable.
 *
 * The cube itself is in cube.prl, which names no platform and draws nothing — it is a *scene
 * painter*, handed the rectangle the layout gave it and appending twelve LINE records for the
 * twelve edges. Every backend already executes those, so the same file also drives
 * cube_desktop.prl on Windows Forms with nothing changed.
 *
 * That is what `Ui->scene` is for: content the toolkit knows nothing about, plugged in as an
 * ordinary widget. It is laid out like a button, it takes `flex: 1` to fill what is left, it sits
 * inside a card, and it composites in tree order — the buttons below are built after it, so they
 * draw over it.
 *
 * Build with:
 *     prolang examples/18-psp-cube/psp_cube.prl --emit-psp
 *     # then, in WSL with the pspdev toolchain on PATH:
 *     make -f Makefile.psp
 *
 * D-pad moves the cursor and Cross clicks; the shoulder triggers spin Y directly. Start quits.
 */

import "psp"
import "ui/host_psp"
import "ui/theme"
import "ui/fps"
import "cube.prl"

enum CubeAct {
    NONE,
    ROT_XP,
    ROT_XM,
    ROT_YP,
    ROT_YM,
    ROT_ZP,
    ROT_ZM,
    RESET,
    SPIN
}

func cube_scene_tag() : int {
    return 1
}

func cube_step() : int {
    return 4
}

// The painter's state and the spin flag, as globals — same reasoning as cube_desktop.prl.
global state: array<int> = cube_state_new()
global spinning: int = 1

func main()
{
    let theme: int = Theme.MIDNIGHT

    cube_set_angles(state, 30, 40, 0)
    cube_set_colour(state, theme_accent(theme))

    let host: PspHost = hostp_open(512)
    let fonts: FontSet = hostp_fonts()
    let ui: Ui = Ui->new(128)
    let frames: Fps = Fps->new()

    while (hostp_running(host)) {
        // The PSP presents on vblank, so this should sit at 60 and drop in whole steps — 30, then
        // 20 — rather than sliding, which is what makes it worth showing on the hardware.
        frames->tick()

        if (spinning == 1) {
            cube_turn_by(state, 1, 2, 0)
        }

        hostp_begin(host, ui)

        // The shoulder buttons rotate directly, which is a nicer thing to hold down than a button
        // is to click repeatedly. The cursor and Cross still work on everything below.
        let held: int = psp_buttons_held()

        if ((held & PspPad.LTRIGGER) != 0) {
            cube_turn_by(state, 0, 0 - cube_step(), 0)
        }
        if ((held & PspPad.RTRIGGER) != 0) {
            cube_turn_by(state, 0, cube_step(), 0)
        }

        ui->col(pad: 6, gap: 4, bg: theme_background(theme))

            ui->row()
                ui->text("X " + state[CubeS.ANG_X]
                          + "  Y " + state[CubeS.ANG_Y]
                          + "  Z " + state[CubeS.ANG_Z], fg: theme_text_dim(theme))

                ui->spacer(flex: 1)

                ui->text(frames->text(), fg: theme_text_dim(theme))
            ui->end()

            ui->scene(tag: cube_scene_tag(), flex: 1, pad: 4, radius: 4, bg: theme_surface(theme))

            ui->row(gap: 4)
                cube_btn(ui, "X-", CubeAct.ROT_XM, theme)
                cube_btn(ui, "X+", CubeAct.ROT_XP, theme)
                cube_btn(ui, "Y-", CubeAct.ROT_YM, theme)
                cube_btn(ui, "Y+", CubeAct.ROT_YP, theme)
                ui->spacer(flex: 1)
                cube_btn(ui, "Spin", CubeAct.SPIN, theme)
                cube_btn(ui, "Reset", CubeAct.RESET, theme)
            ui->end()

            ui->text("L/R spin  Start quits", fg: theme_text_dim(theme))

        ui->end()

        let act: int = hostp_present_scene(host, ui, fonts, cube_paint, state,
            theme_background(theme))

        let step: int = cube_step()

        if (act == CubeAct.ROT_XP) {
            cube_turn_by(state, step, 0, 0)
        } elif (act == CubeAct.ROT_XM) {
            cube_turn_by(state, 0 - step, 0, 0)
        } elif (act == CubeAct.ROT_YP) {
            cube_turn_by(state, 0, step, 0)
        } elif (act == CubeAct.ROT_YM) {
            cube_turn_by(state, 0, 0 - step, 0)
        } elif (act == CubeAct.ROT_ZP) {
            cube_turn_by(state, 0, 0, step)
        } elif (act == CubeAct.ROT_ZM) {
            cube_turn_by(state, 0, 0, 0 - step)
        } elif (act == CubeAct.RESET) {
            cube_set_angles(state, 0, 0, 0)
        } elif (act == CubeAct.SPIN) {
            spinning = 1 - spinning
        }
    }
}

func cube_btn(ui: Ui, label: string, action: int, theme: int) : int {
    return ui->button(label, action: action, bg: theme_surface(theme), fg: theme_text(theme), radius: 4, pad: 5)
}
