<Project>

  <!--
    ProLangProject.targets replaces CoreCompile with a call to the ProLang compiler, so that
    MSBuild can build .prlproj projects.

    It is IMPORTED conditionally rather than having its targets conditioned individually.
    Overriding a target replaces the SDK's definition outright, so a target with a false
    condition is not "skipped" — it is an empty CoreCompile, and nothing gets compiled at all.
    Importing conditionally leaves the SDK's own definition in place for every other project.

    Without this, the override applied to every project under examples/, including the ordinary
    C# library at 05-dotnet-interop-assembly-loading/test_lib. `dotnet build` reported success
    there while producing no assembly, which is why the interop example could never resolve it.
  -->
  <Import Project="$(MSBuildThisFileDirectory)ProLangProject.targets"
          Condition="'$(MSBuildProjectExtension)' == '.prlproj'" />

</Project>
