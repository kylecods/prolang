<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <!-- Each example has its own main(); use build.ps1 to compile all examples. -->
    <!-- This project file compiles 01_hello_world.prl as the default entry point. -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="01_hello_world.prl" />
  </ItemGroup>

</Project>
