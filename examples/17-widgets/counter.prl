/*
 * The widget toolkit, in one screen.
 *
 * Compare this with examples/13-winforms/04_counter.prl, which is the same program written against
 * the old API: there, every control is created at an absolute pixel position, parented by hand,
 * styled by hand, and repositioned by a second hand-written pass when the window is resized.
 *
 * Here the layout is a description. Nothing has a coordinate, and resizing the window works because
 * the tree is laid out again against the new size — there is no second copy of the arithmetic to
 * keep in step with the first.
 *
 * ── The shape of a program ───────────────────────────────────────────────────
 *
 * Build the tree, present it, handle what came back:
 *
 *     while (running) {
 *         hostw_begin(...)      pump input, start the frame
 *         ...build the tree...
 *         act = hostw_present(...)
 *         ...act on it...
 *     }
 *
 * Events are integers rather than callbacks. That is not a limitation being worked around: function
 * values in this language capture nothing, so a handler could not reach `count` anyway. Returning
 * the action to the loop that owns the state is the shape that actually fits — and it keeps every
 * state change in one readable place instead of scattered across handlers.
 *
 * The two pieces of state — the count and the active theme — are globals. Before the language had
 * `global`, each lived in a one-element array so a function could mutate it through the reference;
 * `count[0] = count[0] + 1` was the mutation channel. A global says the same thing without the
 * array wrapper.
 */

import "ui/host_winforms"
import "ui/theme"
import "ui/color"

enum Act {
    NONE,
    INCREMENT,
    DECREMENT,
    RESET,
    THEME,
    QUIT
}

// Fonts, by the index a widget refers to them by.
enum Font {
    BODY,
    TITLE
}

global count: int = 0
global activeTheme: int = Theme.MIDNIGHT

func main()
{
    let host: Host = hostw_open("ProLang Counter", 480, 300,
        background: theme_background(activeTheme))

    hostw_min_size(host, 360, 240)

    // Measured once. Everything after this is integer arithmetic over the table they produced.
    let families: array<string> = array_new(2)
    let sizes: array<int> = array_new(2)
    let bolds: array<int> = array_new(2)

    families[0] = "Segoe UI"
    sizes[0] = 10
    bolds[0] = 0

    families[1] = "Segoe UI"
    sizes[1] = 22
    bolds[1] = 1

    let fonts: FontSet = hostw_fonts(families, sizes, bolds)
    let ui: Ui = Ui->new(256)

    while (hostw_running(host)) {
        let theme: int = activeTheme

        hostw_begin(host, ui)

        ui->col(pad: 20, gap: 16, bg: theme_background(theme))

            ui->text("Counter", font: Font.TITLE, fg: theme_text(theme))

            // The number, on its own card, filling whatever room is left over.
            ui->box(pad: 20, radius: 8, flex: 1, bg: theme_surface(theme), align: UiAlign.CENTER, justify: UiAlign.CENTER)
                ui->text("" + count, font: Font.TITLE, fg: theme_accent(theme))
            ui->end()

            // No height: the row takes it from the tallest button, which takes it from its label
            // and padding. Naming a height here would be a number to keep in step with the font.
            ui->row(gap: 8)
                counter_button(ui, "Decrement", Act.DECREMENT, theme)
                counter_button(ui, "Increment", Act.INCREMENT, theme)
                counter_button(ui, "Reset", Act.RESET, theme)

                // A flexible spacer is how something is pushed to the far end of a row: it takes
                // the leftover space, so everything after it ends up hard against the right edge.
                ui->spacer(flex: 1)

                counter_button(ui, "Theme", Act.THEME, theme)
                counter_button(ui, "Quit", Act.QUIT, theme)
            ui->end()

            ui->text(theme_name(theme) + "   " + hostw_scale(host) + "%", fg: theme_text_dim(theme))

        ui->end()

        let act: int = hostw_present(host, ui, fonts)

        if (act == Act.INCREMENT) {
            count = count + 1
        } elif (act == Act.DECREMENT) {
            count = count - 1
        } elif (act == Act.RESET) {
            count = 0
        } elif (act == Act.THEME) {
            activeTheme = theme_next(theme)
        } elif (act == Act.QUIT) {
            hostw_close(host)
        }
    }
}

/*
 * One toolbar button, themed.
 *
 * A plain function taking the arena — which is all a "component" is here. There is no base class to
 * derive from and no interface to implement: a widget is whatever a function builds, and composing
 * them is calling them.
 */
func counter_button(ui: Ui, label: string, action: int, theme: int) : int {
    return ui->button(label, action: action, bg: theme_surface(theme), fg: theme_text(theme), radius: 6, pad: 10)
}
