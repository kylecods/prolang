/*
 * Text editor tests — keys.prl
 *
 * The virtual-key-to-character table, driven the way the editor drives it: a key code and the
 * shift state, expecting the character a US layout would produce.
 */

import "testing"
import "../keys.prl"

func test_keys_run() : void {
    // ── Letters ──────────────────────────────────────────────────────────────
    t_eq_char("a is lowercase", key_to_char(KeyVk.A, false), 'a')
    t_eq_char("A is shifted", key_to_char(KeyVk.A, true), 'A')
    t_eq_char("z is lowercase", key_to_char(KeyVk.Z, false), 'z')
    t_eq_char("m is lowercase", key_to_char(KeyVk.M, false), 'm')

    // ── Digits ───────────────────────────────────────────────────────────────
    t_eq_char("1 is itself", key_to_char(49, false), '1')
    t_eq_char("0 is itself", key_to_char(48, false), '0')
    t_eq_char("shift+1 is !", key_to_char(49, true), '!')
    t_eq_char("shift+2 is @", key_to_char(50, true), '@')
    t_eq_char("shift+9 is (", key_to_char(57, true), '(')
    t_eq_char("shift+0 is )", key_to_char(48, true), ')')

    // ── Space ────────────────────────────────────────────────────────────────
    t_eq_char("space is a space", key_to_char(KeyVk.SPACE, false), ' ')
    t_eq_char("shift+space is a space", key_to_char(KeyVk.SPACE, true), ' ')

    // ── The OEM punctuation block ────────────────────────────────────────────
    t_eq_char("semicolon", key_to_char(KeyVk.OEM_1, false), ';')
    t_eq_char("colon", key_to_char(KeyVk.OEM_1, true), ':')
    t_eq_char("equals", key_to_char(KeyVk.OEM_PLUS, false), '=')
    t_eq_char("plus", key_to_char(KeyVk.OEM_PLUS, true), '+')
    t_eq_char("comma", key_to_char(KeyVk.OEM_COMMA, false), ',')
    t_eq_char("less than", key_to_char(KeyVk.OEM_COMMA, true), '<')
    t_eq_char("minus", key_to_char(KeyVk.OEM_MINUS, false), '-')
    t_eq_char("underscore", key_to_char(KeyVk.OEM_MINUS, true), '_')
    t_eq_char("period", key_to_char(KeyVk.OEM_PERIOD, false), '.')
    t_eq_char("greater than", key_to_char(KeyVk.OEM_PERIOD, true), '>')
    t_eq_char("slash", key_to_char(KeyVk.OEM_2, false), '/')
    t_eq_char("question mark", key_to_char(KeyVk.OEM_2, true), '?')
    t_eq_char("backtick", key_to_char(KeyVk.OEM_3, false), '`')
    t_eq_char("tilde", key_to_char(KeyVk.OEM_3, true), '~')
    t_eq_char("open bracket", key_to_char(KeyVk.OEM_4, false), '[')
    t_eq_char("open brace", key_to_char(KeyVk.OEM_4, true), '{')
    t_eq_char("backslash", key_to_char(KeyVk.OEM_5, false), '\\')
    t_eq_char("pipe", key_to_char(KeyVk.OEM_5, true), '|')
    t_eq_char("close bracket", key_to_char(KeyVk.OEM_6, false), ']')
    t_eq_char("close brace", key_to_char(KeyVk.OEM_6, true), '}')
    t_eq_char("apostrophe", key_to_char(KeyVk.OEM_7, false), '\'')
    t_eq_char("double quote", key_to_char(KeyVk.OEM_7, true), '"')

    // ── Keys that type nothing ───────────────────────────────────────────────
    t_eq_char("left types nothing", key_to_char(KeyVk.LEFT, false), '\0')
    t_eq_char("delete types nothing", key_to_char(KeyVk.DELETE, false), '\0')
    t_eq_char("enter types nothing", key_to_char(KeyVk.ENTER, false), '\0')
    t_eq_char("backspace types nothing", key_to_char(KeyVk.BACKSPACE, false), '\0')
    t_eq_char("tab types nothing", key_to_char(KeyVk.TAB, false), '\0')
    t_eq_char("F5 types nothing", key_to_char(116, false), '\0')
    t_eq_char("shift itself types nothing", key_to_char(KeyVk.SHIFT, false), '\0')

    // ── Modifiers ────────────────────────────────────────────────────────────
    t_true("shift is a modifier", key_is_modifier(KeyVk.SHIFT))
    t_true("right shift is a modifier", key_is_modifier(KeyVk.RSHIFT))
    t_true("control is a modifier", key_is_modifier(KeyVk.CONTROL))
    t_true("left control is a modifier", key_is_modifier(KeyVk.LCONTROL))
    t_false("A is not a modifier", key_is_modifier(KeyVk.A))
    t_false("space is not a modifier", key_is_modifier(KeyVk.SPACE))
}
