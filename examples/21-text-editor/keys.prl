/*
 * Text editor - the keyboard (keys.prl)
 *
 * The OpenGL host reports the keyboard as polled state, not events: `gl_key_pressed(vk)` says
 * whether a Windows virtual key is held down *this frame*. It never says what was typed. This
 * module is the mapping from that raw state to text and commands: a virtual key plus the shift
 * modifier becomes the character it would have produced on a US layout.
 *
 * Pure prolang: a key becomes a `char` through a cast, with no interop call anywhere, which is
 * what makes the whole editor transpilable to the C and PSP backends. Exercised by
 * tests/test_keys.prl.
 *
 * The editor.prl side does the event part: it remembers last frame's state and treats a
 * held-this-frame-but-not-last-frame key as a press, with its own repeat timer.
 */

// Windows virtual-key codes the editor needs. Letters and digits are contiguous ranges, so only
// the stray keys - the OEM punctuation block and the modifiers - are listed here.
enum KeyVk {
    BACKSPACE = 8,
    TAB = 9,
    ENTER = 13,
    SHIFT = 16,
    CONTROL = 17,
    PAUSE = 19,
    SPACE = 32,
    PRIOR = 33,
    NEXT = 34,
    END = 35,
    HOME = 36,
    LEFT = 37,
    UP = 38,
    RIGHT = 39,
    DOWN = 40,
    INSERT = 45,
    DELETE = 46,
    A = 65,
    M = 77,
    Z = 90,
    LSHIFT = 160,
    RSHIFT = 161,
    LCONTROL = 162,
    RCONTROL = 163,
    OEM_1 = 186,        // ; :
    OEM_PLUS = 187,     // = +
    OEM_COMMA = 188,    // , <
    OEM_MINUS = 189,    // - _
    OEM_PERIOD = 190,   // . >
    OEM_2 = 191,        // / ?
    OEM_3 = 192,        // ` ~
    OEM_4 = 219,        // [ {
    OEM_5 = 220,        // \ |
    OEM_6 = 221,        // ] }
    OEM_7 = 222         // ' "
}

/*
 * The character a key produces.
 *
 * Returns '\0' for every key that types nothing — arrows, function keys, the modifiers
 * themselves — so the caller can try text first and fall through to commands. '\0' is safe as
 * that sentinel because no key types it. `shift` is whether either shift key is held.
 */
func key_to_char(vk: int, shift: bool) : char {
    // Letters: VK codes are the capitals, so shifting changes nothing but the case.
    if (vk >= KeyVk.A && vk <= KeyVk.Z) {
        if (!shift) {
            return char(vk + 32)
        }
        return char(vk)
    }

    // Digits, shifted through the row above them. `1` through `9` map to the first nine symbols
    // and `0` wraps to the last, so the index is taken modulo ten.
    if (vk >= KeyVk.SPACE + 16 && vk <= KeyVk.SPACE + 25) {
        if (shift) {
            let row = "!@#$%^&*()"
            return row.charAt((vk - KeyVk.SPACE - 17 + 10) % 10)
        }
        return char(vk)
    }

    if (vk == KeyVk.SPACE) {
        return ' '
    }

    // The OEM punctuation block, unshifted and shifted.
    if (vk == KeyVk.OEM_1) {
        if (shift) { return ':' }
        return ';'
    }
    if (vk == KeyVk.OEM_PLUS) {
        if (shift) { return '+' }
        return '='
    }
    if (vk == KeyVk.OEM_COMMA) {
        if (shift) { return '<' }
        return ','
    }
    if (vk == KeyVk.OEM_MINUS) {
        if (shift) { return '_' }
        return '-'
    }
    if (vk == KeyVk.OEM_PERIOD) {
        if (shift) { return '>' }
        return '.'
    }
    if (vk == KeyVk.OEM_2) {
        if (shift) { return '?' }
        return '/'
    }
    if (vk == KeyVk.OEM_3) {
        if (shift) { return '~' }
        return '`'
    }
    if (vk == KeyVk.OEM_4) {
        if (shift) { return '{' }
        return '['
    }
    if (vk == KeyVk.OEM_5) {
        if (shift) { return '|' }
        return '\\'
    }
    if (vk == KeyVk.OEM_6) {
        if (shift) { return '}' }
        return ']'
    }
    if (vk == KeyVk.OEM_7) {
        if (shift) { return '"' }
        return '\''
    }

    return '\0'
}

/*
 * Whether this virtual key only modifies — shift, control, alt and their left/right twins.
 * The editor polls these for modifiers and must not treat their own transitions as editing.
 */
func key_is_modifier(vk: int) : bool {
    if (vk == KeyVk.SHIFT || vk == KeyVk.LSHIFT || vk == KeyVk.RSHIFT) { return true }
    if (vk == KeyVk.CONTROL || vk == KeyVk.LCONTROL || vk == KeyVk.RCONTROL) { return true }
    if (vk == 18 || vk == 164 || vk == 165) { return true }
    return false
}
