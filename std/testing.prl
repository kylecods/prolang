/*
 * The test harness
 *
 * The tally lives in two globals: every check increments one of them, and no function has to
 * thread a counter through its parameters or return it. Before the language had `global`, the
 * count was a TestRun struct passed into and returned from every assert, which is the same shape
 * std/dynarray.prl uses for its collections - workable, but every check site carried the plumbing.
 *
 * Checks print only when they fail. A run that passes produces one line per module plus a
 * summary, which keeps the golden stdout file small enough to read as a diff.
 *
 * The run is failed by the `assert` builtin from `import "test"`, called once at the end. That
 * matters more than the printing: a prolang program cannot set an exit code, so before `assert`
 * existed a test suite could only print the word "failed" and still exit 0 - which the execution
 * tests would have recorded as a pass.
 */

import "io"
import "test"
import "util"

global t_passed: int = 0
global t_failed: int = 0

// Where the current module's count started, so t_end_module can report the delta.
global t_module_passed: int = 0
global t_module_failed: int = 0

// Zeroes the tally. A suite calls this once before its first module.
func t_reset() : void {
    t_passed = 0
    t_failed = 0
}

// Marks the start of a module: the counts from here on are reported as that module's.
func t_begin_module() : void {
    t_module_passed = t_passed
    t_module_failed = t_failed
}

// Records a passing check.
func t_pass() : void {
    t_passed = t_passed + 1
}

// Records a failing check and reports it.
func t_fail(name: string, detail: string) : void {
    print("  FAIL " + name + ": " + detail)
    t_failed = t_failed + 1
}

func t_eq_int(name: string, actual: int, expected: int) : void {
    if (actual == expected) {
        t_pass()
        return
    }
    t_fail(name, "expected " + expected + " but got " + actual)
}

func t_eq_bool(name: string, actual: bool, expected: bool) : void {
    if (actual == expected) {
        t_pass()
        return
    }
    t_fail(name, "expected " + expected + " but got " + actual)
}

func t_eq_str(name: string, actual: string, expected: string) : void {
    if (actual == expected) {
        t_pass()
        return
    }
    t_fail(name, "expected " + expected + " but got " + actual)
}

/*
 * Compares two chars, spelling both out in the failure message rather than showing a code point.
 */
func t_eq_char(name: string, actual: char, expected: char) : void {
    if (actual == expected) {
        t_pass()
        return
    }
    t_fail(name, "expected '" + expected + "' but got '" + actual + "'")
}

func t_true(name: string, condition: bool) : void {
    t_eq_bool(name, condition, true)
}

func t_false(name: string, condition: bool) : void {
    t_eq_bool(name, condition, false)
}

// Reports the checks made since the last t_begin_module as one module's result.
func t_end_module(moduleName: string) : void {
    let checks: int = (t_passed - t_module_passed) + (t_failed - t_module_failed)
    let failed: int = t_failed - t_module_failed

    if (failed == 0) {
        print("  " + util_pad_left("" + checks, 4) + " ok   " + moduleName)
    } else {
        print("  " + util_pad_left("" + checks, 4) + " FAIL " + moduleName
              + " (" + failed + " failed)")
    }
}

/*
 * Prints the summary and fails the process if anything failed.
 *
 * The assert is what makes this a real gate rather than a report nobody reads.
 */
func t_report() : void {
    let total: int = t_passed + t_failed

    print("")
    print("passed " + t_passed + " of " + total)

    assert(t_failed == 0, "" + t_failed + " of " + total + " checks failed")
}
