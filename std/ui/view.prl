/*
 * Pixel editor — zoom and pan
 *
 * The mapping between screen coordinates and image coordinates. Pure arithmetic with no calls
 * into the shim, which is the point: this is the code most likely to be subtly wrong, and keeping
 * it free of Windows Forms means tests/test_view.prl can cover it exactly.
 *
 * The mapping is:
 *
 *     screen = (image - pan) * zoom
 *     image  = floor(screen / zoom) + pan
 *
 * WinFormsHelper.CanvasSetView applies the same formula on the C# side. If the two ever disagree,
 * the symptom is a brush that paints one pixel away from the cursor — which looks like a bug in
 * the tool rather than in the coordinate transform.
 */

import "util"

struct View {
    zoom: int;
    panX: int;
    panY: int;
}


imp View {
    // Zoom levels are integers so that one image pixel is always a whole number of screen pixels.
    func min_zoom() : int {
        return 1
    }

    func max_zoom() : int {
        return 32
    }

    // The zoom at which the pixel grid starts being drawn; below it the lines crowd out the image.
    func grid_threshold() : int {
        return 4
    }

    func new(zoom: int) : View {
        return View { zoom: util_clamp(zoom, View->min_zoom(), View->max_zoom()), panX: 0, panY: 0 }
    }

    // ── Transforms ───────────────────────────────────────────────────────────────

    /*
     * The image column under a screen x, which may be outside the image.
     *
     * Floor division, not prolang's `/`. Truncating division maps the whole range -zoom+1..zoom-1
     * onto column 0, so the column immediately left of the image would be indistinguishable from its
     * first column and a stroke starting just off-canvas would paint on it.
     */
    func to_image_x(self: View, screenX: int) : int {
        return util_floor_div(screenX, self.zoom) + self.panX
    }

    func to_image_y(self: View, screenY: int) : int {
        return util_floor_div(screenY, self.zoom) + self.panY
    }

    func to_screen_x(self: View, imageX: int) : int {
        return (imageX - self.panX) * self.zoom
    }

    func to_screen_y(self: View, imageY: int) : int {
        return (imageY - self.panY) * self.zoom
    }

    // ── Zoom ─────────────────────────────────────────────────────────────────────

    /*
     * Changes zoom while keeping the image pixel under (anchorX, anchorY) in the same place.
     *
     * Zooming about the top-left instead is the easy version and is unpleasant to use: the area being
     * worked on slides out of view every time the wheel turns. Anchoring at the cursor keeps it still.
     */
    func zoom_to(self: View, zoom: int, anchorX: int, anchorY: int) : View {
        let target: int = util_clamp(zoom, View->min_zoom(), View->max_zoom())

        if (target == self.zoom) {
            return self
        }

        // Which image pixel is under the anchor now; it must still be under it afterwards.
        let imageX: int = self->to_image_x(anchorX)
        let imageY: int = self->to_image_y(anchorY)

        let panX: int = imageX - util_floor_div(anchorX, target)
        let panY: int = imageY - util_floor_div(anchorY, target)

        return View { zoom: target, panX: panX, panY: panY }
    }

    func zoom_in(self: View, anchorX: int, anchorY: int) : View {
        return self->zoom_to(self.zoom * 2, anchorX, anchorY)
    }

    func zoom_out(self: View, anchorX: int, anchorY: int) : View {
        return self->zoom_to(self.zoom / 2, anchorX, anchorY)
    }

    func show_grid(self: View) : bool {
        return self.zoom >= View->grid_threshold()
    }

    // ── Pan ──────────────────────────────────────────────────────────────────────

    func pan_by(self: View, dx: int, dy: int) : View {
        return View { zoom: self.zoom, panX: self.panX + dx, panY: self.panY + dy }
    }

    /*
     * Keeps the image from being scrolled entirely off the canvas.
     *
     * The pan is allowed to run one screenful past each edge rather than being pinned to the image
     * bounds, so there is room to work comfortably at the very edge of the canvas.
     */
    func clamp_pan(self: View, imageWidth: int, imageHeight: int, canvasWidth: int, canvasHeight: int) : View {
        let visibleX: int = util_floor_div(canvasWidth, self.zoom)
        let visibleY: int = util_floor_div(canvasHeight, self.zoom)

        let panX: int = util_clamp(self.panX, 0 - visibleX, imageWidth)
        let panY: int = util_clamp(self.panY, 0 - visibleY, imageHeight)

        return View { zoom: self.zoom, panX: panX, panY: panY }
    }

    /*
     * Centres the image in a canvas of the given size.
     *
     * Used on new and open, so an image smaller than the canvas appears in the middle rather than
     * tucked into the corner.
     */
    func centre(self: View, imageWidth: int, imageHeight: int, canvasWidth: int, canvasHeight: int) : View {
        let visibleX: int = util_floor_div(canvasWidth, self.zoom)
        let visibleY: int = util_floor_div(canvasHeight, self.zoom)

        return View {
            zoom: self.zoom,
            panX: 0 - ((visibleX - imageWidth) / 2),
            panY: 0 - ((visibleY - imageHeight) / 2)
        }
    }

    /*
     * The largest zoom at which the whole image fits in the canvas, for a "fit" command.
     */
    func fit_zoom(imageWidth: int, imageHeight: int, canvasWidth: int, canvasHeight: int) : int {
        if (imageWidth < 1 || imageHeight < 1) {
            return 1
        }

        let byWidth: int = canvasWidth / imageWidth
        let byHeight: int = canvasHeight / imageHeight

        return util_clamp(min(byWidth, byHeight), View->min_zoom(), View->max_zoom())
    }
}
