/*
 * The self-hosted compiler — driver (main.prl)
 *
 * Phase 1 of self-hosting: lexes and parses a prolang file with the prolang-written frontend
 * and dumps what it produced, so the frontend can be tested against the reference compiler.
 *
 *   dotnet selfhost.dll program.prl                -- parse, report diagnostics
 *   dotnet selfhost.dll program.prl --tokens      -- dump the token stream
 *   dotnet selfhost.dll program.prl --ast         -- dump the syntax tree
 *
 * The binder port lands in Phase 2; until then this exists to prove the arena representation
 * and hand the parser something to build.
 */

import "io"
import "fs"
import "token.prl"
import "diag.prl"
import "lexer.prl"
import "ast.prl"
import "parser.prl"

func main(args: array<string>) {
    tok_init_names()
    nodk_init_names()

    let path: string = ""
    let mode: int = 0            // 0 = parse only, 1 = tokens, 2 = ast
    let i: int = 0
    while (i < args.length()) {
        let arg: string = args[i]
        if (arg == "--tokens") {
            mode = 1
        } else if (arg == "--ast") {
            mode = 2
        } else if (path == "") {
            path = arg
        }
        i = i + 1
    }

    if (path == "") {
        print("usage: selfhost <file.prl> [--tokens | --ast]")
        return
    }

    let text: string = readFile(path)
    if (text.length() == 0) {
        // readFile returns "" both for an empty file and a failed read; distinguish via the
        // builtin fileExists.
        if (!fileExists(path)) {
            print("no such file: " + path)
            return
        }
    }

    lex_all(text)

    if (mode == 1) {
        dump_tokens()
        return
    }

    ast_reset()
    let file: int = parse_program()

    print("tokens: " + t_count)
    print("nodes: " + n_count)
    print("diagnostics: " + d_count)
    diag_print_all()

    if (mode == 2) {
        dump_ast(file, 0)
    }
}

func dump_tokens() : void {
    let i: int = 0
    while (i < t_count) {
        let line: string = t_kind_name[t_kind[i]] + " " + t_line[i] + ":" + t_col[i]

        if (t_kind[i] == TokK.IDENT) {
            line = line + " " + t_str[i]
        } else if (t_kind[i] == TokK.STRING) {
            line = line + " " + t_str[i]
        } else if (t_kind[i] == TokK.INT) {
            line = line + " " + t_int[i]
        } else if (t_kind[i] == TokK.FLOAT32 || t_kind[i] == TokK.FLOAT64) {
            // There is no float-to-text conversion in the language, so a float token dumps
            // its source lexeme — which is what a diff against the reference wants anyway.
            line = line + " " + tok_text(i)
        } else {
            line = line + " '" + tok_text(i) + "'"
        }

        print(line)
        i = i + 1
    }
}

// ── AST dump ─────────────────────────────────────────────────────────────────

global nd_names: array<string> = array_new(64)

func nodk_init_names() : void {
    nd_names[NodK.FILE] = "File"
    nd_names[NodK.IMPORT] = "Import"
    nd_names[NodK.FUNC] = "Function"
    nd_names[NodK.STRUCT] = "Struct"
    nd_names[NodK.FIELD] = "Field"
    nd_names[NodK.ENUM] = "Enum"
    nd_names[NodK.ENUM_MEMBER] = "EnumMember"
    nd_names[NodK.GLOBAL_VAR] = "GlobalVar"
    nd_names[NodK.TYPE_NAME] = "TypeName"
    nd_names[NodK.TYPE_GENERIC] = "TypeGeneric"
    nd_names[NodK.TYPE_ARRAY] = "TypeArray"
    nd_names[NodK.TYPE_FUNC] = "TypeFunc"
    nd_names[NodK.BLOCK] = "Block"
    nd_names[NodK.LET] = "Let"
    nd_names[NodK.EXPR_STMT] = "ExpressionStatement"
    nd_names[NodK.IF] = "If"
    nd_names[NodK.WHILE] = "While"
    nd_names[NodK.FOR] = "For"
    nd_names[NodK.RETURN] = "Return"
    nd_names[NodK.BREAK] = "Break"
    nd_names[NodK.CONTINUE] = "Continue"
    nd_names[NodK.INT_LIT] = "IntLiteral"
    nd_names[NodK.FLOAT_LIT] = "FloatLiteral"
    nd_names[NodK.STR_LIT] = "StringLiteral"
    nd_names[NodK.BOOL_LIT] = "BoolLiteral"
    nd_names[NodK.NULL_LIT] = "NullLiteral"
    nd_names[NodK.NAME] = "Name"
    nd_names[NodK.UNARY] = "Unary"
    nd_names[NodK.BINARY] = "Binary"
    nd_names[NodK.ASSIGN] = "Assignment"
    nd_names[NodK.CAST] = "Cast"
    nd_names[NodK.CALL] = "Call"
    nd_names[NodK.METHOD_CALL] = "MethodCall"
    nd_names[NodK.FIELD_ACCESS] = "FieldAccess"
    nd_names[NodK.INDEX] = "Index"
    nd_names[NodK.ARRAY_LIT] = "ArrayLiteral"
    nd_names[NodK.MAP_LIT] = "MapLiteral"
    nd_names[NodK.MAP_ENTRY] = "MapEntry"
    nd_names[NodK.STRUCT_LIT] = "StructLiteral"
    nd_names[NodK.FIELD_INIT] = "FieldInit"
    nd_names[NodK.PAREN] = "Paren"
    nd_names[NodK.NAMED_ARG] = "NamedArgument"
    nd_names[NodK.PARAM] = "Parameter"
    nd_names[NodK.LIST] = "List"
}

/*
 * Prints a node and everything under it, indented. The line is the node kind plus whatever
 * payload the node carries, so a dump can be read — and diffed — as text.
 */
func dump_ast(id: int, depth: int) : void {
    if (id == 0) {
        return
    }

    let indent: string = ""
    let i: int = 0
    while (i < depth) {
        indent = indent + "  "
        i = i + 1
    }

    let line: string = indent + nd_names[n_kind[id]]

    if (n_str[id] != "") {
        line = line + " " + n_str[id]
    }
    if (n_kind[id] == NodK.INT_LIT) {
        line = line + " " + n_a[id]
    }
    if (n_kind[id] == NodK.FLOAT_LIT) {
        line = line + " " + tok_text(n_tok[id])
    }
    if (n_kind[id] == NodK.BOOL_LIT) {
        if (n_a[id] == 1) {
            line = line + " true"
        } else {
            line = line + " false"
        }
    }
    if (n_kind[id] == NodK.BINARY || n_kind[id] == NodK.UNARY || n_kind[id] == NodK.ASSIGN) {
        line = line + " '" + tok_text(n_tok[id]) + "'"
    }

    print(line)

    // INT_LIT and BOOL_LIT keep a value in slot a, not a node reference — do not descend.
    if (n_kind[id] == NodK.INT_LIT || n_kind[id] == NodK.BOOL_LIT) {
        return
    }

    // Slots first, then the kid list in order.
    dump_ast(n_a[id], depth + 1)
    dump_ast(n_b[id], depth + 1)
    dump_ast(n_c[id], depth + 1)
    dump_ast(n_d[id], depth + 1)

    let kid: int = ast_kid_head(id)
    while (kid != 0) {
        dump_ast(kid, depth + 1)
        kid = ast_kid_next(kid)
    }
}
