<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      Declared so a plain `dotnet build` restores the win-x64 RID target. install.ps1 builds
      without a RID and then publishes with the no-build flag and `-r win-x64`; without this,
      the assets file has no net10.0/win-x64 target and publish fails with NETSDK1047. The
      plural form only affects restore, so the ordinary build is unchanged.
    -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!--
    Native AOT publish. The compiler is AOT-compatible because .NET interop discovery reads
    assemblies as metadata only (MetadataLoadContext) and the emitter writes IL with Mono.Cecil —
    neither loads or JITs foreign code. Publish with:

        dotnet publish src/ProLang/ProLang.csproj -c Release -r win-x64 -p:PublishAot=true

    The ordinary build is unchanged; these properties only apply to that publish.
  -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <!-- Diagnostics matter for a compiler, so keep stack traces. -->
    <StackTraceSupport>true</StackTraceSupport>
  </PropertyGroup>

  <!--
    Packaged as a .NET global tool, so `dotnet tool install` is an alternative to install.ps1 for
    anyone who would rather not have a script edit their PATH. Both deliver the same thing; the
    script exists as well because it needs no package feed and works offline from a clone.

    These properties only affect `dotnet pack`. An ordinary build is unchanged.
  -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>prolang</ToolCommandName>
    <PackageId>ProLang.Compiler</PackageId>
    <Version>0.2.0</Version>
    <Authors>ProLang</Authors>
    <Description>The ProLang compiler: compiles .prl to .NET assemblies, C99, or a native launcher, and serves editors as a language server.</Description>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\nupkg</PackageOutputPath>
  </PropertyGroup>

  <!--
    What the tool package must carry beyond the compiler itself.

    runtime\ and lib\ are produced by the AfterTargets steps at the bottom of this file, which copy
    into the build output rather than declaring project items — so the packaging machinery cannot
    see them and they are named here explicitly. The paths are the ones those targets write to.

    Without runtime\, an installed tool compiles programs that cannot start: ProLang.Runtime.dll is
    copied next to every emitted assembly and is what print() calls into.
  -->
  <ItemGroup>
    <None Include="$(OutputPath)runtime\ProLang.Runtime.dll"
          Pack="true"
          PackagePath="tools\$(TargetFramework)\any\runtime\"
          Visible="false" />
    <None Include="$(OutputPath)lib\*.dll"
          Pack="true"
          PackagePath="tools\$(TargetFramework)\any\lib\"
          Visible="false"
          Condition="'$(OS)' == 'Windows_NT'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="Mono.Options" Version="6.12.0.148" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <!--
      Metadata-only reflection for .NET interop discovery. Reading imported assemblies through
      MetadataLoadContext instead of loading them for execution is what makes the compiler itself
      publishable as Native AOT — an AOT binary cannot JIT-load arbitrary managed assemblies.
    -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="9.0.0" />
  </ItemGroup>

  <!--
    The compiler's types are almost all `internal`. The test project needs to drive
    the emitter and its collaborators directly, not just through the CLI.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="ProLang.Tests" />
    <InternalsVisibleTo Include="ProLang.Benchmarks" />
  </ItemGroup>

  <!--
    The prolang standard library, shipped beside the compiler.

    ProLangCompilation resolves an extensionless `import "ui/shape"` against the std\ directory
    next to the compiler executable, so this copy is what makes the library importable at all —
    and %(RecursiveDir) is what keeps `ui\` a directory rather than flattening it into std\.
    Packing them as content is also what puts the library inside the `dotnet tool` package.
  -->
  <ItemGroup>
    <!--
      PackagePath deliberately stops at `any\`, without repeating %(RecursiveDir). NuGet appends
      the item's Link to it, and Link already carries the subdirectory — so naming it in both put
      every ui\ module into the package twice, once at std\ui\ and once again at std\ui\ui\.
      The build output was always right, which is why it went unnoticed: only an installation made
      from the package carried the duplicates.
    -->
    <Content Include="..\..\std\**\*.prl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>std\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <Pack>true</Pack>
      <PackagePath>tools\$(TargetFramework)\any\</PackagePath>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\native\*.h" LogicalName="ProLang.native.%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    ProLang.Runtime is not linked into the compiler — the compiler only ever reads it with Cecil
    to resolve references, and copies it next to each program it emits. ReferenceOutputAssembly
    is false so it is not treated as a compile-time dependency; the ProjectReference exists purely
    to order the builds. The output lands in runtime/ where RuntimeLibraryLocator looks for it.
  -->
  <ItemGroup>
    <ProjectReference Include="..\ProLang.Runtime\ProLang.Runtime.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <Target Name="CopyProLangRuntime" AfterTargets="Build" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <_RuntimeFiles Include="$(MSBuildThisFileDirectory)..\ProLang.Runtime\bin\$(Configuration)\$(TargetFramework)\ProLang.Runtime.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_RuntimeFiles)"
          DestinationFolder="$(OutDir)runtime"
          SkipUnchangedFiles="true"
          Condition="'@(_RuntimeFiles)' != ''" />
  </Target>

  <!--
    On Windows, build WinFormsHelper after the main ProLang build and drop
    WinFormsHelper.dll into the compiler output's lib/ subdirectory.
    This lets prolang source files use  import "winforms"  or  import "WinFormsHelper"
    without specifying an explicit DLL path.
  -->
  <Target Name="BuildWinFormsHelper" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <_WFHProj>$(MSBuildThisFileDirectory)..\..\std\WinFormsHelper\WinFormsHelper.csproj</_WFHProj>
      <_WFHLibDir>$(OutDir)lib</_WFHLibDir>
    </PropertyGroup>
    <MakeDir Directories="$(_WFHLibDir)" />
    <Exec Command="dotnet build &quot;$(_WFHProj)&quot; -c $(Configuration) -o &quot;$(_WFHLibDir)&quot; --nologo -v q" />
  </Target>

  <!--
    On Windows, build GLHelper after the main ProLang build and drop
    GLHelper.dll into the compiler output's lib/ subdirectory.
    This lets prolang source files use  import "gl"  or  import "GLHelper"
    without specifying an explicit DLL path.
  -->
  <Target Name="BuildGLHelper" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <_GLHProj>$(MSBuildThisFileDirectory)..\..\std\GLHelper\GLHelper.csproj</_GLHProj>
      <_GLHLibDir>$(OutDir)lib</_GLHLibDir>
    </PropertyGroup>
    <MakeDir Directories="$(_GLHLibDir)" />
    <Exec Command="dotnet build &quot;$(_GLHProj)&quot; -c $(Configuration) -o &quot;$(_GLHLibDir)&quot; --nologo -v q" />
  </Target>

</Project>
