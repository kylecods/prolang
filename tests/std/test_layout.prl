/*
 * Pixel editor tests — layout.prl
 *
 * Layout is the one part of the interface that can be wrong on a machine nobody testing it owns.
 * The editor is developed on a 100% display and will be run on 125%, 150% and 200% ones, where
 * the failures are not crashes but a toolbar half a button too narrow, a rule that no longer meets
 * the bar it edges, or a window taller than the screen.
 *
 * So these check the *relationships* — the bar is wide enough for its buttons, the window is
 * exactly its parts, nothing rounds away to nothing — at every scaling factor Windows offers,
 * rather than checking particular pixel counts at the one factor this machine happens to have.
 */

import "array"
import "testing"
import "ui/layout"

// The factors the Windows display settings offer, plus the two extremes of the clamp.
func test_layout_scales() : array<int> {
    let scales: array<int> = array_new(8)
    scales[0] = 100
    scales[1] = 125
    scales[2] = 150
    scales[3] = 175
    scales[4] = 200
    scales[5] = 225
    scales[6] = 250
    scales[7] = 350
    return scales
}

func test_layout_run() : void {
    // ── Scaling ──────────────────────────────────────────────────────────────
    t_eq_int("an unscaled display changes nothing", layout_px(100, 36), 36)
    t_eq_int("125% of 36", layout_px(125, 36), 45)
    t_eq_int("150% of 36", layout_px(150, 36), 54)
    t_eq_int("200% of 36", layout_px(200, 36), 72)

    // Rounded, not truncated: at 150% a truncating divide leaves a 3-pixel gap at 4 and a
    // 1-pixel rule at 1, and the two errors pull the layout apart in opposite directions.
    t_eq_int("a half rounds up", layout_px(150, 1), 2)
    t_eq_int("125% of 10 is exact", layout_px(125, 10), 13)
    t_eq_int("zero scales to zero", layout_px(150, 0), 0)

    t_eq_int("a normal factor passes through", layout_clamp_scale(150), 150)
    t_eq_int("an impossible factor is refused", layout_clamp_scale(0), 100)
    t_eq_int("a factor below 100 is refused", layout_clamp_scale(75), 100)
    t_eq_int("an absurd factor is capped", layout_clamp_scale(9600), 350)

    // ── Invariants at every scaling factor ───────────────────────────────────
    let scales: array<int> = test_layout_scales()
    let count: int = scales.length()

    let barFits: int = 0
    let topBarFits: int = 0
    let iconFits: int = 0
    let iconVisible: int = 0
    let ruleVisible: int = 0
    let widthAdds: int = 0
    let heightAdds: int = 0
    let contentPlaced: int = 0
    let grows: int = 0

    let i: int = 0
    while (i < count) {
        let scale: int = scales[i]
        let button: int = layout_button(scale)
        let icon: int = layout_icon(scale)

        // The tool bar has to hold its own two columns of buttons and their margins. Deriving its
        // width from them rather than stating it is what makes this true by construction, and
        // this is the check that it stayed that way.
        let needed: int = (button * layout_tool_columns())
                          + (layout_button_gap(scale) * (layout_tool_columns() - 1))
                          + (layout_gap(scale) * 2)
        if (layout_leftbar(scale) >= needed) {
            barFits = barFits + 1
        }

        // A button must fit inside the top bar with room left over, or it touches both edges.
        if (layout_topbar(scale) >= button + (layout_gap(scale) / 2)) {
            topBarFits = topBarFits + 1
        }

        // An icon has to be smaller than the button it sits on, and big enough to identify.
        if (icon < button) {
            iconFits = iconFits + 1
        }
        if ((icon * 2) >= button) {
            iconVisible = iconVisible + 1
        }

        // A hairline must never round down to nothing, whatever the factor.
        if (layout_divider(scale) >= 1) {
            ruleVisible = ruleVisible + 1
        }

        // The window is exactly its parts. If these drift, the canvas and the window disagree
        // about where the right-hand margin is and the layout looks lopsided.
        let canvas: int = layout_canvas_width(scale, layout_px(scale, 1400))
        let palette: int = layout_palette_cell(scale) * 1
        let tall: int = layout_canvas_height(scale, layout_px(scale, 1000), palette)

        if (layout_window_width(scale, canvas) == layout_side_chrome(scale) + canvas) {
            widthAdds = widthAdds + 1
        }
        if (layout_window_height(scale, tall, palette) == layout_stack_chrome(scale, palette) + tall) {
            heightAdds = heightAdds + 1
        }

        // The canvas sits inside the window with a margin on the far side, not flush against it.
        if (layout_content_x(scale) + canvas + layout_gap(scale) == layout_window_width(scale, canvas)) {
            contentPlaced = contentPlaced + 1
        }

        // Everything gets larger as the display does, which is the whole point.
        if (i > 0) {
            let smaller: int = scales[i - 1]
            if (layout_button(scale) > layout_button(smaller)
                && layout_icon(scale) > layout_icon(smaller)
                && layout_topbar(scale) > layout_topbar(smaller)
                && layout_leftbar(scale) > layout_leftbar(smaller)) {
                grows = grows + 1
            }
        }

        i = i + 1
    }

    t_eq_int("the tool bar fits its buttons at every factor", barFits, count)
    t_eq_int("the top bar fits its buttons at every factor", topBarFits, count)
    t_eq_int("an icon fits its button at every factor", iconFits, count)
    t_eq_int("an icon stays identifiable at every factor", iconVisible, count)
    t_eq_int("a rule never vanishes at any factor", ruleVisible, count)
    t_eq_int("the window width is its parts", widthAdds, count)
    t_eq_int("the window height is its parts", heightAdds, count)
    t_eq_int("the canvas keeps its far margin", contentPlaced, count)
    t_eq_int("every metric grows with the display", grows, count - 1)

    // ── The canvas against the room available ────────────────────────────────
    let palette: int = layout_palette_cell(100) * 2

    /*
     * A screen too small for the chrome gets the floor rather than a negative canvas.
     *
     * The floor and not the workable size, deliberately. Opening at a size the screen cannot show
     * would put the palette and the status bar under the taskbar; using everything the screen has
     * is the honest answer, and the window's minimum is capped the same way for the same reason.
     */
    t_eq_int("a cramped screen falls back to the floor width",
                 layout_canvas_width(100, 200), layout_min_canvas_width(100))
    t_eq_int("a cramped screen falls back to the floor height",
                 layout_canvas_height(100, 200, palette), layout_min_canvas_height(100))

    // A very wide monitor does not get a window spanning all of it.
    t_eq_int("a wide screen is capped", layout_canvas_width(100, 6000), layout_px(100, 1040))
    t_eq_int("a tall screen is capped", layout_canvas_height(100, 4000, palette), layout_px(100, 700))

    // Between the two, the canvas takes what is left and the window is exactly the screen.
    let usable: int = 1000
    let middling: int = layout_canvas_width(100, usable)
    t_true("a middling screen is not capped", middling < layout_px(100, 1040))
    t_eq_int("a middling screen is used fully", layout_window_width(100, middling), usable)

    // The same window at 200% is about twice the size, which is what "the same window" means on a
    // display with twice the pixels.
    let atOne: int = layout_window_width(100, layout_canvas_width(100, 3000))
    let atTwo: int = layout_window_width(200, layout_canvas_width(200, 6000))
    t_eq_int("the capped window doubles with the display", atTwo, atOne * 2)

    // ── Following a resized window ───────────────────────────────────────────
    /*
     * The canvas takes whatever the chrome does not, so that maximising the window fills it
     * rather than leaving a band of background down the right-hand side.
     *
     * The invariant is the same one the opening window has — the canvas plus the chrome is exactly
     * the client area — but it has to hold at *every* size, not just the one the editor opened at.
     */
    let exact: int = 0
    let noOverflow: int = 0
    let widths: array<int> = test_layout_scales()

    let s: int = 0
    while (s < widths.length()) {
        let factor: int = widths[s]
        let cellSize: int = layout_palette_cell(factor)

        // A spread of client sizes: cramped, ordinary, and a maximised ultrawide.
        let client: int = layout_px(factor, 700)
        while (client <= layout_px(factor, 3400)) {
            let wide: int = layout_canvas_width_for(factor, client)
            let high: int = layout_canvas_height_for(factor, client, cellSize)

            if (layout_content_x(factor) + wide + layout_gap(factor) == client) {
                exact = exact + 1
            }

            // Never larger than the window, whatever it is asked for.
            if (wide <= client && high <= client) {
                noOverflow = noOverflow + 1
            }

            client = client + layout_px(factor, 337)
        }

        s = s + 1
    }

    t_true("the canvas fills the window at every size", exact > 40)
    t_eq_int("the canvas never overflows the window", noOverflow, exact)

    // A window dragged below the minimum gives the canvas the minimum rather than a negative
    // width, which would place every control after it on top of the ones before.
    t_eq_int("a tiny window still yields a usable canvas",
                 layout_canvas_width_for(100, 10), layout_min_canvas_width(100))
    t_eq_int("a tiny window still yields a usable canvas height",
                 layout_canvas_height_for(100, 10, 26), layout_min_canvas_height(100))

    // Unlike the opening size, a resized canvas is not capped: dragging the window wider was
    // asked for, where opening full-width on a wide monitor was not.
    t_true("a maximised window is not capped",
               layout_canvas_width_for(100, 3000) > layout_canvas_width(100, 3000))

    // ── The window's minimum ─────────────────────────────────────────────────
    // The point of a minimum is that the editor is still usable at it, so the window stops while
    // the canvas is a workable size rather than when it reaches the floor that keeps the
    // arithmetic from going negative.
    t_true("the workable canvas is well clear of the floor",
               layout_workable_width(100) > layout_min_canvas_width(100) * 2)
    t_true("the workable canvas height is well clear of the floor",
               layout_workable_height(100) > layout_min_canvas_height(100) * 2)

    let roomy: int = 4000

    // At the minimum, the canvas is exactly the workable size — no more and no less.
    t_eq_int("the minimum window holds a workable canvas",
                 layout_canvas_width_for(100, layout_min_width(100, 100, roomy)),
                 layout_workable_width(100))
    t_eq_int("the minimum window holds a workable canvas height",
                 layout_canvas_height_for(100, layout_min_height(100, 26, roomy), 26),
                 layout_workable_height(100))

    /*
     * A palette wider than the workable canvas widens the window instead of being clipped.
     *
     * The palette is the one thing under the canvas whose width is its own rather than whatever is
     * left — sixteen swatches are sixteen swatches. Sizing the window to the canvas alone let the
     * strip run off the right-hand edge at the smallest size the window could be dragged to.
     */
    let wideStrip: int = 900
    t_eq_int("a wide palette sets the minimum instead",
                 layout_canvas_width_for(100, layout_min_width(100, wideStrip, roomy)), wideStrip)
    t_true("a wide palette widens the window",
               layout_min_width(100, wideStrip, roomy) > layout_min_width(100, 100, roomy))
    t_eq_int("a narrow palette does not narrow the window",
                 layout_min_width(100, 10, roomy), layout_min_width(100, 100, roomy))

    /*
     * The screen has the last word.
     *
     * A minimum larger than the display is one the user cannot satisfy, and Windows honours it
     * regardless — leaving a window that cannot be made to fit its own screen. That is reachable
     * without anything exotic: a 200% laptop wants a minimum in physical pixels twice the size of
     * one at 100%, on a panel that has not doubled.
     */
    t_eq_int("a cramped screen caps the minimum width",
                 layout_min_width(200, 400, 700), 700)
    t_eq_int("a cramped screen caps the minimum height",
                 layout_min_height(200, 52, 500), 500)

    let cappedFits: int = 0
    let f: int = 0
    while (f < widths.length()) {
        let factor: int = widths[f]
        let cellSize: int = layout_palette_cell(factor)

        if (layout_min_width(factor, cellSize * 16, 1366) <= 1366
            && layout_min_height(factor, cellSize, 720) <= 720) {
            cappedFits = cappedFits + 1
        }

        f = f + 1
    }
    t_eq_int("the minimum fits a small screen at every factor", cappedFits, widths.length())

    // Below the floor the canvas stops shrinking, so a window smaller than its own minimum — which
    // is what a capped minimum on a small screen leaves possible — still lays out.
    t_eq_int("the canvas stops at the floor",
                 layout_canvas_width_for(100, 10), layout_min_canvas_width(100))
    t_eq_int("the canvas height stops at the floor",
                 layout_canvas_height_for(100, 10, 26), layout_min_canvas_height(100))

    // ── Supersampling ────────────────────────────────────────────────────────
    // It deliberately does not depend on the display: it is about how many coverage levels an
    // edge gets, not how many pixels the edge is.
    t_true("icons are supersampled", layout_supersample() > 1)
    t_true("supersampling stays affordable", layout_supersample() <= 4)
}
