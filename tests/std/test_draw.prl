/*
 * ui/draw — the display list.
 *
 * This is the contract every backend implements, so the tests assert the exact commands a known
 * tree produces. If a change here is deliberate the expected values move with it; if it is not,
 * this is what says so before a backend renders the wrong thing.
 */

import "testing"
import "ui/widget"
import "ui/box"
import "ui/hit"
import "ui/draw"
import "ui/color"
import "ui/font"

func test_draw_fonts() : FontSet {
    let fonts: FontSet = font_new(1)

    font_set_monospace(fonts, 0, 10, 20, 16)

    return fonts
}

func test_draw_run() : void {
    test_draw_surfaces()
    test_draw_button_states()
    test_draw_overflow()
}

func test_draw_surfaces() : void {
    let fonts: FontSet = test_draw_fonts()
    let ui: Ui = ui_new(32)
    let ops: array<int> = array_new(64 * dl_stride())

    let panel: int = color_rgb(10, 20, 30)
    let ink: int = color_rgb(240, 240, 240)

    ui_begin(ui, 0, 0, false)
    let root: int = ui_col(ui, pad: 4, bg: panel, radius: 3)
        ui_text(ui, "ab", fg: ink)
    ui_end(ui)

    box_layout(ui, fonts, root, 0, 0, 100, 40)
    hit_resolve(ui)

    let count: int = dl_build(ui, fonts, root, ops)

    // A background and a text run: the structural column contributes nothing else.
    t_eq_int("two records", count, 2)

    // A radius turns the background into a rounded rectangle.
    t_eq_int("background is rounded", dl_op(ops, 0), DlOp.RRECT)
    t_eq_int("background x", dl_arg(ops, 0, 0), 0)
    t_eq_int("background width", dl_arg(ops, 0, 2), 100)
    t_eq_int("background colour", dl_arg(ops, 0, 4), panel)
    t_eq_int("background radius", dl_arg(ops, 0, 5), 3)

    // Text sits inside the column's padding, and carries a string-table index rather than a string.
    t_eq_int("text record", dl_op(ops, 1), DlOp.TEXT)
    t_eq_int("text x", dl_arg(ops, 1, 0), 4)
    t_eq_int("text y", dl_arg(ops, 1, 1), 4)
    t_eq_int("text index", dl_arg(ops, 1, 2), 0)
    t_eq_int("text colour", dl_arg(ops, 1, 3), ink)
    t_eq_str("the index resolves", ui.strs[dl_arg(ops, 1, 2)], "ab")

    // A transparent background emits nothing — most nodes in a real tree are structural.
    ui_begin(ui, 0, 0, false)
    let bare: int = ui_col(ui)
        ui_text(ui, "ab", fg: ink)
    ui_end(ui)

    box_layout(ui, fonts, bare, 0, 0, 100, 40)
    hit_resolve(ui)

    count = dl_build(ui, fonts, bare, ops)
    t_eq_int("a transparent surface is skipped", count, 1)
    t_eq_int("only the text remains", dl_op(ops, 0), DlOp.TEXT)

    // Without a radius it is a plain rectangle.
    ui_begin(ui, 0, 0, false)
    let square: int = ui_col(ui, bg: panel)
    ui_end(ui)

    box_layout(ui, fonts, square, 0, 0, 10, 10)
    hit_resolve(ui)

    count = dl_build(ui, fonts, square, ops)
    t_eq_int("no radius means a plain rect", dl_op(ops, 0), DlOp.RECT)
}

func test_draw_button_states() : void {
    let fonts: FontSet = test_draw_fonts()
    let ui: Ui = ui_new(32)
    let ops: array<int> = array_new(64 * dl_stride())

    let face: int = color_rgb(60, 60, 60)

    // Idle: the button is drawn in the colour it was given.
    ui_begin(ui, 900, 900, false)
    let idle: int = ui_button(ui, "ab", action: 7, bg: face, width: 60, height: 24)
    box_layout(ui, fonts, idle, 0, 0, 60, 24)
    hit_resolve(ui)

    let count: int = dl_build(ui, fonts, idle, ops)

    t_eq_int("a button is a surface and a label", count, 2)
    t_eq_int("idle uses the given colour", dl_arg(ops, 0, 4), face)

    // The label is centred within the button by the display list, not by layout.
    t_eq_int("label is centred horizontally", dl_arg(ops, 1, 0), 20)
    t_eq_int("label is centred vertically", dl_arg(ops, 1, 1), 2)

    // Hovered: lighter.
    ui_begin(ui, 30, 12, false)
    let hovered: int = ui_button(ui, "ab", action: 7, bg: face, width: 60, height: 24)
    box_layout(ui, fonts, hovered, 0, 0, 60, 24)
    hit_resolve(ui)

    count = dl_build(ui, fonts, hovered, ops)
    t_eq_int("hovered lightens", dl_arg(ops, 0, 4), color_shade(face, dl_hover_shade()))

    // Pressed: lighter still, and distinct from hovered.
    ui_begin(ui, 30, 12, true)
    let pressed: int = ui_button(ui, "ab", action: 7, bg: face, width: 60, height: 24)
    box_layout(ui, fonts, pressed, 0, 0, 60, 24)
    hit_resolve(ui)

    count = dl_build(ui, fonts, pressed, ops)
    t_eq_int("pressed lightens further", dl_arg(ops, 0, 4), color_shade(face, dl_press_shade()))
    t_true("pressed differs from hovered",
        color_shade(face, dl_press_shade()) != color_shade(face, dl_hover_shade()))
}

/*
 * A buffer too small to hold the frame truncates rather than writing past its end.
 *
 * The caller can see it happened by comparing the count against dl_capacity. Dying mid-paint would
 * be worse than a frame missing its last few commands.
 */
func test_draw_overflow() : void {
    let fonts: FontSet = test_draw_fonts()
    let ui: Ui = ui_new(32)
    let tiny: array<int> = array_new(2 * dl_stride())

    let ink: int = color_rgb(255, 255, 255)

    ui_begin(ui, 0, 0, false)
    let root: int = ui_col(ui)
        ui_text(ui, "a", fg: ink)
        ui_text(ui, "b", fg: ink)
        ui_text(ui, "c", fg: ink)
        ui_text(ui, "d", fg: ink)
    ui_end(ui)

    box_layout(ui, fonts, root, 0, 0, 100, 100)
    hit_resolve(ui)

    let count: int = dl_build(ui, fonts, root, tiny)

    t_eq_int("capacity is in records", dl_capacity(tiny), 2)
    t_eq_int("emission stops at the capacity", count, 2)
}
