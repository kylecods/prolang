/*
 * ui/scene — the pluggable custom-content widget.
 *
 * A scene is the toolkit's escape hatch: a rectangle the application fills with something the
 * toolkit knows nothing about. What is asserted here is that it behaves like an ordinary widget
 * while doing so — it takes part in layout, it is handed the right rectangle, and its records land
 * in tree order so that z-order against its siblings is what the tree says it is.
 */

import "testing"
import "ui/widget"
import "ui/box"
import "ui/hit"
import "ui/draw"
import "ui/color"
import "ui/font"

func test_scene_fonts() : FontSet {
    let fonts: FontSet = FontSet->new(1)

    fonts->set_monospace(0, 10, 20, 16)

    return fonts
}

/*
 * A painter that records what it was given and emits one rectangle.
 *
 * `state` is how a painter reaches anything at all — a function value captures nothing — so the
 * test reads back through the same channel the painter wrote through.
 */
func test_scene_painter(ops: array<int>, at: int, tag: int,
                        x: int, y: int, w: int, h: int, state: array<int>) : int {
    state[0] = state[0] + 1
    state[1] = tag
    state[2] = x
    state[3] = y
    state[4] = w
    state[5] = h

    return dl_emit(ops, at, DlOp.RECT, x, y, w, h, state[6], 0)
}

// A painter emitting several records, to check that a scene may contribute more than one.
func test_scene_multi(ops: array<int>, at: int, tag: int,
                      x: int, y: int, w: int, h: int, state: array<int>) : int {
    let next: int = at
    let i: int = 0

    while (i < 3) {
        next = dl_emit(ops, next, DlOp.LINE, x, y + i, x + w, y + i, state[6], 1)
        i = i + 1
    }

    return next
}

func test_scene_run() : void {
    test_scene_widget()
    test_scene_paints()
    test_scene_order()
}

// ── It is an ordinary widget ─────────────────────────────────────────────────

func test_scene_widget() : void {
    let fonts: FontSet = test_scene_fonts()
    let ui: Ui = ui_new(32)

    ui_begin(ui, 0, 0, false)
    let root: int = ui_col(ui, pad: 10, gap: 5)
        let label: int = ui_text(ui, "ab")
        let scene: int = ui_scene(ui, tag: 7, flex: 1)
    ui_end(ui)

    t_eq_int("scene kind", ui_kind(ui, scene), UiKind.SCENE)
    t_eq_int("tag recorded", ui_get(ui, scene, UiF.SCENE_TAG), 7)
    t_false("a scene is a leaf", ui_is_container(ui, scene))
    t_eq_int("a scene takes no children", ui_child_count(ui, scene), 0)

    box_layout(ui, fonts, root, 0, 0, 200, 100)

    // flex: 1 means it absorbs what the label leaves, inside the column's padding.
    t_eq_int("scene fills the leftover height", box_h(ui, scene), 55)
    t_eq_int("scene spans the content width", box_w(ui, scene), 180)
    t_eq_int("scene sits below the label", box_y(ui, scene), 35)

    // Not clickable unless it asks to be — a scene is not a button.
    t_eq_int("no id by default", ui_get(ui, scene, UiF.ID), 0)

    ui_begin(ui, 0, 0, false)
    let clickable: int = ui_scene(ui, tag: 1, action: 42)
    t_eq_int("a scene may take an action", ui_get(ui, clickable, UiF.ACTION), 42)
    t_eq_int("and is then hit tested", ui_get(ui, clickable, UiF.ID), 42)
}

// ── The painter ──────────────────────────────────────────────────────────────

func test_scene_paints() : void {
    let fonts: FontSet = test_scene_fonts()
    let ui: Ui = ui_new(32)
    let ops: array<int> = array_new(64 * dl_stride())
    let state: array<int> = array_new(8)

    let ink: int = color_rgb(10, 200, 30)
    state[6] = ink

    ui_begin(ui, 0, 0, false)
    let scene: int = ui_scene(ui, tag: 5, pad: 4, bg: color_rgb(1, 2, 3))
    box_layout(ui, fonts, scene, 0, 0, 100, 60)
    hit_resolve(ui)

    // Without a painter the scene still reserves its space and shows its background, which is what
    // makes a forgotten painter look like an empty panel rather than a crash.
    let bare: int = dl_build(ui, fonts, scene, ops)
    t_eq_int("no painter emits only the background", bare, 1)
    t_eq_int("the background is a rect", dl_op(ops, 0), DlOp.RECT)
    t_eq_int("the painter was not called", state[0], 0)

    // With one, its records follow the background.
    let painted: int = dl_build_scenes(ui, fonts, scene, ops, test_scene_painter, state)
    t_eq_int("painter adds a record", painted, 2)
    t_eq_int("painter called once", state[0], 1)
    t_eq_int("painter got the tag", state[1], 5)

    // The rectangle handed over is inside the scene's own padding.
    t_eq_int("painter x is inside the padding", state[2], 4)
    t_eq_int("painter y is inside the padding", state[3], 4)
    t_eq_int("painter width less padding", state[4], 92)
    t_eq_int("painter height less padding", state[5], 52)

    t_eq_int("the painter's record is present", dl_op(ops, 1), DlOp.RECT)
    t_eq_int("with the painter's colour", dl_arg(ops, 1, 4), ink)

    // A painter may emit as many records as it likes.
    let many: int = dl_build_scenes(ui, fonts, scene, ops, test_scene_multi, state)
    t_eq_int("several records from one scene", many, 4)
    t_eq_int("all of them are the painter's", dl_op(ops, 3), DlOp.LINE)

    // A scene with no room left does not call the painter at all, so a painter never has to guard
    // against a zero or negative size.
    state[0] = 0
    ui_begin(ui, 0, 0, false)
    let squashed: int = ui_scene(ui, tag: 1, pad: 40)
    box_layout(ui, fonts, squashed, 0, 0, 10, 10)
    hit_resolve(ui)

    let none: int = dl_build_scenes(ui, fonts, squashed, ops, test_scene_painter, state)
    t_eq_int("no room means no painter call", state[0], 0)
}

// ── Tree order ───────────────────────────────────────────────────────────────

/*
 * A scene composites where the tree says, not before or after everything.
 *
 * This is the property that separates a real widget from a viewport drawn around the interface: a
 * sibling built after the scene must paint over it, and one built before must paint under it.
 */
func test_scene_order() : void {
    let fonts: FontSet = test_scene_fonts()
    let ui: Ui = ui_new(32)
    let ops: array<int> = array_new(64 * dl_stride())
    let state: array<int> = array_new(8)

    let under: int = color_rgb(1, 1, 1)
    let over: int = color_rgb(2, 2, 2)
    let sceneInk: int = color_rgb(3, 3, 3)

    state[6] = sceneInk

    ui_begin(ui, 0, 0, false)
    let root: int = ui_col(ui)
        ui_box(ui, bg: under, height: 10)
        ui_end(ui)
        ui_scene(ui, tag: 1, height: 10)
        ui_box(ui, bg: over, height: 10)
        ui_end(ui)
    ui_end(ui)

    box_layout(ui, fonts, root, 0, 0, 60, 30)
    hit_resolve(ui)

    let count: int = dl_build_scenes(ui, fonts, root, ops, test_scene_painter, state)

    t_eq_int("three records", count, 3)
    t_eq_int("the earlier sibling comes first", dl_arg(ops, 0, 4), under)
    t_eq_int("the scene is in the middle", dl_arg(ops, 1, 4), sceneInk)
    t_eq_int("the later sibling paints last", dl_arg(ops, 2, 4), over)
}
