/*
 * Pixel editor tests — fill.prl
 */

import "testing"
import "ui/fill"
import "ui/document"
import "ui/raster"
import "ui/color"

func test_fill_run() : void {
    let white: int = color_rgb(255, 255, 255)
    let black: int = color_rgb(0, 0, 0)
    let red: int = color_rgb(255, 0, 0)
    let log: array<int> = array_new(4096)

    // Filling an empty canvas reaches every pixel.
    let doc: Document = Document->new(8, 8, white)
    let changed: int = fill_flood(doc, 0, 0, black)
    t_eq_int("fill covers the whole canvas", changed, 64)
    t_eq_int("every pixel changed", doc->count_colour(black), 64)

    // Filling with the colour already there must return immediately. Without the early exit the
    // traversal never terminates: recolouring to the same value leaves every neighbour matching.
    let same: int = fill_flood(doc, 0, 0, black)
    t_eq_int("filling with the same colour is a no-op", same, 0)

    // A wall splits the canvas: the fill must stop at it.
    let walled: Document = Document->new(8, 8, white)
    raster_line(walled, 4, 0, 4, 7, 1, black, log, 0)

    let left: int = fill_flood(walled, 0, 0, red)
    t_eq_int("fill stops at the wall", left, 32)
    t_eq_int("left side is filled", walled->get(3, 3), red)
    t_eq_int("wall is untouched", walled->get(4, 3), black)
    t_eq_int("right side is untouched", walled->get(5, 3), white)

    // The fill is four-connected, so a diagonal gap does not leak.
    let diagonal: Document = Document->new(4, 4, white)
    diagonal->set(1, 0, black)
    diagonal->set(0, 1, black)

    let corner: int = fill_flood(diagonal, 0, 0, red)
    t_eq_int("diagonal contact does not leak", corner, 1)
    t_eq_int("only the corner changed", diagonal->get(0, 0), red)
    t_eq_int("the far side is untouched", diagonal->get(1, 1), white)

    // A fully enclosed region fills without escaping.
    let enclosed: Document = Document->new(8, 8, white)
    raster_rect(enclosed, 1, 1, 6, 6, 1, black, log, 0)

    let inside: int = fill_flood(enclosed, 3, 3, red)
    t_eq_int("enclosed fill covers the interior", inside, 16)
    t_eq_int("outside the border is untouched", enclosed->get(0, 0), white)

    // Starting outside the canvas does nothing rather than failing.
    let ignored: int = fill_flood(enclosed, 0 - 1, 0, red)
    t_eq_int("fill outside the canvas is a no-op", ignored, 0)

    // A single-pixel canvas is the smallest case the stack arithmetic has to handle.
    let tiny: Document = Document->new(1, 1, white)
    t_eq_int("one pixel canvas fills", fill_flood(tiny, 0, 0, red), 1)

    // The stack is sized at one entry per pixel, which holds only because a pixel is recoloured
    // when it is pushed. A canvas of one uniform colour is the worst case for that bound.
    let large: Document = Document->new(64, 64, white)
    t_eq_int("large uniform fill completes", fill_flood(large, 32, 32, red), 4096)

    // replace_all ignores connectivity.
    let scattered: Document = Document->new(4, 4, white)
    scattered->set(0, 0, black)
    scattered->set(3, 3, black)

    t_eq_int("replace_all reaches both", fill_replace_all(scattered, black, red), 2)
    t_eq_int("first is replaced", scattered->get(0, 0), red)
    t_eq_int("second is replaced", scattered->get(3, 3), red)
    t_eq_int("replace_all with the same colour is a no-op",
                 fill_replace_all(scattered, red, red), 0)
}
