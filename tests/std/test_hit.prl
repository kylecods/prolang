/*
 * ui/hit — hover, press and click.
 *
 * A click is a press and a release on the same widget, so every check here drives at least two
 * frames. `ui_begin` takes this frame's pointer state and moves the last one into MOUSE_WAS_DOWN,
 * which is what turns a held button into an edge.
 */

import "testing"
import "ui/widget"
import "ui/box"
import "ui/hit"
import "ui/font"

func test_hit_fonts() : FontSet {
    let fonts: FontSet = FontSet->new(1)

    fonts->set_monospace(0, 10, 20, 16)

    return fonts
}

/*
 * Builds the same two-button row every frame, lays it out and resolves the pointer.
 *
 * Rebuilding identically is the point: the tree is discarded each frame, so the only thing carrying
 * state from one to the next is the widget's id.
 */
func test_hit_frame(ui: Ui, fonts: FontSet, mouseX: int, mouseY: int, down: bool) : int {
    ui_begin(ui, mouseX, mouseY, down)

    let root: int = ui_row(ui, gap: 0)
        ui_button(ui, "ab", action: 101, width: 50, height: 20)
        ui_button(ui, "cd", action: 202, width: 50, height: 20)
    ui_end(ui)

    box_layout(ui, fonts, root, 0, 0, 100, 20)

    return hit_resolve(ui)
}

func test_hit_run() : void {
    let fonts: FontSet = test_hit_fonts()
    let ui: Ui = ui_new(32)

    // Hovering the first button makes it hot and fires nothing.
    let fired: int = test_hit_frame(ui, fonts, 10, 10, false)
    t_eq_int("hovering fires nothing", fired, 0)
    t_eq_int("the first button is hot", hit_hot_id(ui), 101)

    // Moving to the second changes what is hot.
    fired = test_hit_frame(ui, fonts, 70, 10, false)
    t_eq_int("the second button is hot", hit_hot_id(ui), 202)

    // Off the row entirely: nothing is hot.
    fired = test_hit_frame(ui, fonts, 70, 500, false)
    t_eq_int("nothing is hot off the row", hit_hot_id(ui), 0)

    // Pressing arms the button but does not fire it — this is the property that lets a press be
    // taken back.
    fired = test_hit_frame(ui, fonts, 10, 10, true)
    t_eq_int("pressing fires nothing", fired, 0)
    t_eq_int("pressing makes the button active", hit_active_id(ui), 101)

    // Holding is not a repeat: a second frame with the button still down fires nothing.
    fired = test_hit_frame(ui, fonts, 10, 10, true)
    t_eq_int("holding does not repeat", fired, 0)
    t_eq_int("still active while held", hit_active_id(ui), 101)

    // Releasing on the same button is the click.
    fired = test_hit_frame(ui, fonts, 10, 10, false)
    t_eq_int("releasing fires the action", fired, 101)
    t_eq_int("nothing is active afterwards", hit_active_id(ui), 0)

    // And it fires exactly once: the next frame is quiet.
    fired = test_hit_frame(ui, fonts, 10, 10, false)
    t_eq_int("the action fires only once", fired, 0)

    // Press one button, release over the other: neither fires.
    fired = test_hit_frame(ui, fonts, 10, 10, true)
    t_eq_int("press on the first", hit_active_id(ui), 101)

    fired = test_hit_frame(ui, fonts, 70, 10, false)
    t_eq_int("releasing elsewhere fires nothing", fired, 0)
    t_eq_int("and clears the active widget", hit_active_id(ui), 0)

    // Press, then slide off the row and release: nothing fires.
    fired = test_hit_frame(ui, fonts, 70, 10, true)
    t_eq_int("press on the second", hit_active_id(ui), 202)

    fired = test_hit_frame(ui, fonts, 70, 900, false)
    t_eq_int("releasing off the widget fires nothing", fired, 0)

    // A held button that the cursor has left is no longer drawn as pressed, even though the press
    // is still armed — the feedback has to say that releasing there will do nothing.
    fired = test_hit_frame(ui, fonts, 70, 10, true)
    let heldButton: int = 2

    t_true("held and hovered reads as active", hit_is_active(ui, heldButton))

    fired = test_hit_frame(ui, fonts, 10, 10, true)
    t_false("held but not hovered does not read as active", hit_is_active(ui, heldButton))
}
