/*
 * ui/box — the layout pass.
 *
 * These assert *relationships* rather than particular pixel counts: that children fill their parent
 * exactly, that a flexible child absorbs what is left, that padding is subtracted once. That is
 * what survives the sizes being retuned, and it is what catches the errors that matter — a row
 * whose children overrun it by a pixel per child looks fine until the tenth child.
 *
 * The font is monospace with an advance of 10 and a line height of 20, so a string's width is ten
 * times its length and every expected number below is one anybody can check by eye.
 */

import "testing"
import "ui/widget"
import "ui/box"
import "ui/font"

func test_box_fonts() : FontSet {
    let fonts: FontSet = FontSet->new(1)

    fonts->set_monospace(0, 10, 20, 16)

    return fonts
}

func test_box_run() : void {
    test_box_natural()
    test_box_row()
    test_box_flex()
    test_box_align()
    test_box_nesting()
}

// ── Natural sizes ────────────────────────────────────────────────────────────

func test_box_natural() : void {
    let fonts: FontSet = test_box_fonts()
    let ui: Ui = Ui->new(32)

    ui->begin(0, 0, false)
    let root: int = ui->col(pad: 5)
        let label: int = ui->text("abcd")
    ui->end()

    box_measure(ui, fonts, root)

    // Text takes its width from the font table and its height from the line height.
    t_eq_int("text width", box_w(ui, label), 40)
    t_eq_int("text height", box_h(ui, label), 20)

    // A container wraps its content in its own padding, on both edges of each axis.
    t_eq_int("column adds padding to width", box_w(ui, root), 50)
    t_eq_int("column adds padding to height", box_h(ui, root), 30)

    // A fixed size replaces the measurement outright.
    ui->begin(0, 0, false)
    let sized: int = ui->col(pad: 5, width: 100, height: 7)
        ui->text("ignored")
    ui->end()

    box_measure(ui, fonts, sized)

    t_eq_int("fixed width wins", box_w(ui, sized), 100)
    t_eq_int("fixed height wins", box_h(ui, sized), 7)
}

// ── Rows ─────────────────────────────────────────────────────────────────────

func test_box_row() : void {
    let fonts: FontSet = test_box_fonts()
    let ui: Ui = Ui->new(32)

    ui->begin(0, 0, false)
    let root: int = ui->row(gap: 6)
        let a: int = ui->text("ab")      // 20 wide
        let b: int = ui->text("cdef")    // 40 wide
    ui->end()

    box_measure(ui, fonts, root)

    // Natural width is the children plus the gaps between them — one gap, not two.
    t_eq_int("row natural width", box_w(ui, root), 66)
    t_eq_int("row natural height", box_h(ui, root), 20)

    box_layout(ui, fonts, root, 0, 0, 66, 20)

    t_eq_int("first child at the left edge", box_x(ui, a), 0)
    t_eq_int("second child clears the gap", box_x(ui, b), 26)

    // The children and the gap account for every pixel of the row.
    let spanned: int = (box_x(ui, b) + box_w(ui, b)) - box_x(ui, a)
    t_eq_int("children span the row exactly", spanned, box_w(ui, root))
}

// ── Flexible children ────────────────────────────────────────────────────────

func test_box_flex() : void {
    let fonts: FontSet = test_box_fonts()
    let ui: Ui = Ui->new(32)

    // One flexible child takes everything the fixed ones leave.
    ui->begin(0, 0, false)
    let root: int = ui->row()
        let left: int = ui->text("ab")           // 20 wide
        let filler: int = ui->spacer(flex: 1)
        let right: int = ui->text("cd")          // 20 wide
    ui->end()

    box_layout(ui, fonts, root, 0, 0, 200, 20)

    t_eq_int("fixed child keeps its width", box_w(ui, left), 20)
    t_eq_int("spacer absorbs the remainder", box_w(ui, filler), 160)
    t_eq_int("trailing child is pushed to the end", box_x(ui, right), 180)

    // Three-way division: 100 does not divide by 3, and the remainder must not be lost.
    ui->begin(0, 0, false)
    let thirds: int = ui->row()
        let one: int = ui->spacer(flex: 1)
        let two: int = ui->spacer(flex: 1)
        let three: int = ui->spacer(flex: 1)
    ui->end()

    box_layout(ui, fonts, thirds, 0, 0, 100, 10)

    let sum: int = box_w(ui, one) + box_w(ui, two) + box_w(ui, three)
    t_eq_int("thirds sum to the whole", sum, 100)
    t_eq_int("the last flexible child takes the remainder", box_w(ui, three), 34)

    // Unequal weights divide in proportion.
    ui->begin(0, 0, false)
    let weighted: int = ui->row()
        let small: int = ui->spacer(flex: 1)
        let large: int = ui->spacer(flex: 3)
    ui->end()

    box_layout(ui, fonts, weighted, 0, 0, 80, 10)

    t_eq_int("weight 1 of 4", box_w(ui, small), 20)
    t_eq_int("weight 3 of 4", box_w(ui, large), 60)
}

// ── Alignment ────────────────────────────────────────────────────────────────

func test_box_align() : void {
    let fonts: FontSet = test_box_fonts()
    let ui: Ui = Ui->new(32)

    // A column stretches its children across the cross axis by default.
    ui->begin(0, 0, false)
    let stretched: int = ui->col()
        let wide: int = ui->text("ab")
    ui->end()

    box_layout(ui, fonts, stretched, 0, 0, 90, 40)
    t_eq_int("stretch fills the cross axis", box_w(ui, wide), 90)

    // Centring leaves equal space either side.
    ui->begin(0, 0, false)
    let centred: int = ui->col(align: UiAlign.CENTER)
        let middle: int = ui->text("ab")     // 20 wide
    ui->end()

    box_layout(ui, fonts, centred, 0, 0, 90, 40)
    t_eq_int("centred keeps its natural width", box_w(ui, middle), 20)
    t_eq_int("centred is offset by half the slack", box_x(ui, middle), 35)

    // END puts the child against the far edge.
    ui->begin(0, 0, false)
    let trailing: int = ui->col(align: UiAlign.END)
        let last: int = ui->text("ab")
    ui->end()

    box_layout(ui, fonts, trailing, 0, 0, 90, 40)
    t_eq_int("END aligns to the far edge", box_x(ui, last), 70)

    // With no flexible child, justify decides where the leftover main-axis space goes.
    ui->begin(0, 0, false)
    let pushed: int = ui->row(justify: UiAlign.END)
        let item: int = ui->text("ab")
    ui->end()

    box_layout(ui, fonts, pushed, 0, 0, 100, 20)
    t_eq_int("justify END shifts along the main axis", box_x(ui, item), 80)
}

// ── Nesting ──────────────────────────────────────────────────────────────────

func test_box_nesting() : void {
    let fonts: FontSet = test_box_fonts()
    let ui: Ui = Ui->new(64)

    ui->begin(0, 0, false)
    let root: int = ui->col(pad: 10, gap: 5)
        let header: int = ui->text("ab")
        let body: int = ui->row(gap: 4)
            let leftCell: int = ui->spacer(flex: 1)
            let rightCell: int = ui->spacer(flex: 1)
        ui->end()
    ui->end()

    box_layout(ui, fonts, root, 0, 0, 200, 100)

    // Padding is applied once, at the top of the tree.
    t_eq_int("content starts inside the padding", box_x(ui, header), 10)
    t_eq_int("content top is inside the padding", box_y(ui, header), 10)

    // The nested row inherits the column's content width.
    t_eq_int("nested row fills the content width", box_w(ui, body), 180)
    t_eq_int("nested row clears the header and gap", box_y(ui, body), 35)

    // The row's own children divide its width, minus its own gap.
    let cells: int = box_w(ui, leftCell) + box_w(ui, rightCell) + 4
    t_eq_int("cells and gap fill the row", cells, box_w(ui, body))
    t_eq_int("cells divide evenly", box_w(ui, leftCell), 88)

    // The right cell begins after the left one and its gap — no overlap, no drift.
    t_eq_int("second cell follows the first",
        box_x(ui, rightCell), box_x(ui, leftCell) + box_w(ui, leftCell) + 4)

    // Hit testing reads these rectangles, so containment has to agree with them.
    t_true("a point inside the header hits it", box_contains(ui, header, 12, 12))
    t_false("a point above the header misses", box_contains(ui, header, 12, 2))
    t_false("the far edge is exclusive",
        box_contains(ui, header, box_x(ui, header) + box_w(ui, header), 12))
}
