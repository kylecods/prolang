/*
 * Pixel editor tests — util.prl
 */

import "testing"
import "util"

func test_util_run() : void {
    t_eq_int("abs positive", util_abs(7), 7)
    t_eq_int("abs negative", util_abs(0 - 7), 7)
    t_eq_int("abs zero", util_abs(0), 0)

    t_eq_int("sign positive", util_sign(42), 1)
    t_eq_int("sign negative", util_sign(0 - 42), 0 - 1)
    t_eq_int("sign zero", util_sign(0), 0)

    t_eq_int("clamp below", util_clamp(0 - 5, 0, 10), 0)
    t_eq_int("clamp above", util_clamp(15, 0, 10), 10)
    t_eq_int("clamp inside", util_clamp(5, 0, 10), 5)
    t_eq_int("clamp on low edge", util_clamp(0, 0, 10), 0)
    t_eq_int("clamp on high edge", util_clamp(10, 0, 10), 10)

    // Floor division is the reason view.prl maps screen coordinates correctly at the left and
    // top edges. Truncating division would give 0 for all three negative cases below, putting
    // the pixel left of the canvas into column 0.
    t_eq_int("floor_div exact", util_floor_div(8, 4), 2)
    t_eq_int("floor_div rounds down", util_floor_div(9, 4), 2)
    t_eq_int("floor_div negative", util_floor_div(0 - 1, 4), 0 - 1)
    t_eq_int("floor_div negative exact", util_floor_div(0 - 8, 4), 0 - 2)
    t_eq_int("floor_div negative rounds down", util_floor_div(0 - 9, 4), 0 - 3)
    t_eq_int("floor_div by zero", util_floor_div(5, 0), 0)

    t_eq_str("pad shorter", util_pad_left("9", 3), "  9")
    t_eq_str("pad exact", util_pad_left("123", 3), "123")
    t_eq_str("pad longer", util_pad_left("1234", 3), "1234")

    t_eq_int("parse simple", util_parse_int("42", 0 - 1), 42)
    t_eq_int("parse zero", util_parse_int("0", 0 - 1), 0)
    t_eq_int("parse leading zero", util_parse_int("007", 0 - 1), 7)
    t_eq_int("parse empty falls back", util_parse_int("", 0 - 1), 0 - 1)
    t_eq_int("parse junk falls back", util_parse_int("12a", 0 - 1), 0 - 1)
    t_eq_int("parse negative falls back", util_parse_int("-5", 0 - 1), 0 - 1)
}
