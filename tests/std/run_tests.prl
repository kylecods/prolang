/*
 * Standard library test suite
 *
 * Covers everything under `std/` that is pure prolang: the two general helpers and the whole of
 * the `ui/` toolkit. Run it with:
 *
 *   dotnet run --project src/ProLang/ProLang.csproj -- tests/std/run_tests.prl -o bin/std-tests.dll
 *   dotnet bin/std-tests.dll
 *
 * It is classified `Runnable` in src/ProLang.Tests/Infrastructure/TestCorpus.cs, so `dotnet test`
 * compiles it, runs it, and compares its output against a golden file. The execution tests demand
 * a zero exit code and empty stderr, and t_report's `assert` breaks both when a check fails.
 *
 * Nothing reachable from here imports "winforms", deliberately. The whole import graph is compiled
 * into one assembly, and a single reference to the shim would make this program require the
 * Windows Desktop runtime pack and stop it being runnable under test. That is the line `ui/chrome`
 * sits on, and it is the one module in the library with no tests for exactly that reason.
 */

import "io"
import "testing"
import "test_util.prl"
import "test_intstack.prl"
import "test_color.prl"
import "test_document.prl"
import "test_raster.prl"
import "test_shape.prl"
import "test_fill.prl"
import "test_history.prl"
import "test_palette.prl"
import "test_view.prl"
import "test_theme.prl"
import "test_icons.prl"
import "test_layout.prl"
import "test_font.prl"
import "test_widget.prl"
import "test_box.prl"
import "test_hit.prl"
import "test_draw.prl"
import "test_scene.prl"
import "test_fps.prl"

func main()
{
    print("prolang standard library test suite")
    print("")

    t_reset()

    t_begin_module()
    test_util_run()
    t_end_module("util")

    t_begin_module()
    test_intstack_run()
    t_end_module("intstack")

    t_begin_module()
    test_color_run()
    t_end_module("ui/color")

    t_begin_module()
    test_document_run()
    t_end_module("ui/document")

    t_begin_module()
    test_raster_run()
    t_end_module("ui/raster")

    t_begin_module()
    test_shape_run()
    t_end_module("ui/shape")

    t_begin_module()
    test_fill_run()
    t_end_module("ui/fill")

    t_begin_module()
    test_history_run()
    t_end_module("ui/history")

    t_begin_module()
    test_palette_run()
    t_end_module("ui/palette")

    t_begin_module()
    test_view_run()
    t_end_module("ui/view")

    t_begin_module()
    test_theme_run()
    t_end_module("ui/theme")

    t_begin_module()
    test_icons_run()
    t_end_module("ui/icons")

    t_begin_module()
    test_layout_run()
    t_end_module("ui/layout")

    t_begin_module()
    test_font_run()
    t_end_module("ui/font")

    t_begin_module()
    test_widget_run()
    t_end_module("ui/widget")

    t_begin_module()
    test_box_run()
    t_end_module("ui/box")

    t_begin_module()
    test_hit_run()
    t_end_module("ui/hit")

    t_begin_module()
    test_draw_run()
    t_end_module("ui/draw")

    t_begin_module()
    test_scene_run()
    t_end_module("ui/scene")

    t_begin_module()
    test_fps_run()
    t_end_module("ui/fps")

    t_report()
}
