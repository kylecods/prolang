/*
 * Pixel editor tests — intstack.prl
 */

import "testing"
import "intstack"

func test_intstack_run() : void {
    let s: IntStack = intstack_new(4)

    t_true("new stack is empty", intstack_is_empty(s))
    t_eq_int("new stack count", intstack_count(s), 0)
    t_eq_int("peek when empty", intstack_peek(s), 0 - 1)

    // Popping an empty stack returns it unchanged rather than failing: prolang has no exceptions
    // and no way to signal an error from a function returning a struct.
    s = intstack_pop(s)
    t_eq_int("pop when empty is a no-op", intstack_count(s), 0)

    s = intstack_push(s, 10)
    s = intstack_push(s, 20)
    s = intstack_push(s, 30)

    t_eq_int("count after pushes", intstack_count(s), 3)
    t_false("not empty after pushes", intstack_is_empty(s))
    t_eq_int("peek returns the top", intstack_peek(s), 30)
    t_eq_int("peek does not remove", intstack_count(s), 3)

    s = intstack_pop(s)
    t_eq_int("pop exposes the next", intstack_peek(s), 20)
    t_eq_int("count after pop", intstack_count(s), 2)

    // Last in, first out.
    s = intstack_pop(s)
    t_eq_int("second pop", intstack_peek(s), 10)
    s = intstack_pop(s)
    t_true("empty after draining", intstack_is_empty(s))

    // The capacity is fixed because every caller knows its bound in advance. A push past it is
    // dropped rather than writing out of range, which prolang could not survive.
    let full: IntStack = intstack_new(2)
    full = intstack_push(full, 1)
    full = intstack_push(full, 2)
    full = intstack_push(full, 3)
    t_eq_int("push past capacity is dropped", intstack_count(full), 2)
    t_eq_int("top is the last accepted", intstack_peek(full), 2)

    let cleared: IntStack = intstack_clear(full)
    t_true("clear empties the stack", intstack_is_empty(cleared))

    // Mutators return a new struct and the caller reassigns; the original binding is unchanged.
    // This is forced by value semantics, not a style choice, so it is worth pinning down.
    let original: IntStack = intstack_new(4)
    let pushed: IntStack = intstack_push(original, 99)
    t_eq_int("original count is unchanged", intstack_count(original), 0)
    t_eq_int("returned count is updated", intstack_count(pushed), 1)
}
