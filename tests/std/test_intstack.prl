/*
 * Pixel editor tests — intstack.prl
 */

import "testing"
import "intstack"

func test_intstack_run() : void {
    let s: IntStack = IntStack->new(4)

    t_true("new stack is empty", s->is_empty())
    t_eq_int("new stack count", s->count(), 0)
    t_eq_int("peek when empty", s->peek(), 0 - 1)

    // Popping an empty stack returns it unchanged rather than failing: prolang has no exceptions
    // and no way to signal an error from a function returning a struct.
    s = s->pop()
    t_eq_int("pop when empty is a no-op", s->count(), 0)

    s = s->push(10)
    s = s->push(20)
    s = s->push(30)

    t_eq_int("count after pushes", s->count(), 3)
    t_false("not empty after pushes", s->is_empty())
    t_eq_int("peek returns the top", s->peek(), 30)
    t_eq_int("peek does not remove", s->count(), 3)

    s = s->pop()
    t_eq_int("pop exposes the next", s->peek(), 20)
    t_eq_int("count after pop", s->count(), 2)

    // Last in, first out.
    s = s->pop()
    t_eq_int("second pop", s->peek(), 10)
    s = s->pop()
    t_true("empty after draining", s->is_empty())

    // The capacity is fixed because every caller knows its bound in advance. A push past it is
    // dropped rather than writing out of range, which prolang could not survive.
    let full: IntStack = IntStack->new(2)
    full = full->push(1)
    full = full->push(2)
    full = full->push(3)
    t_eq_int("push past capacity is dropped", full->count(), 2)
    t_eq_int("top is the last accepted", full->peek(), 2)

    let cleared: IntStack = full->clear()
    t_true("clear empties the stack", cleared->is_empty())

    // Mutators return a new struct and the caller reassigns; the original binding is unchanged.
    // This is forced by value semantics, not a style choice, so it is worth pinning down.
    let original: IntStack = IntStack->new(4)
    let pushed: IntStack = original->push(99)
    t_eq_int("original count is unchanged", original->count(), 0)
    t_eq_int("returned count is updated", pushed->count(), 1)
}
