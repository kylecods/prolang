import "io"

// Test extractQuotedString function.
// The delimiter is a bracket rather than a quote so the point of the test stays
// substring extraction, not tokenization.

func extractBracketed(text: string, startPos: int) : string {
    let pos = startPos + 1
    let result = ""

    while(pos < text.length()) {
        let ch = text.charAt(pos)

        if(ch == ']') {
            return result
        }

        result = result + string(ch)
        pos = pos + 1
    }

    return result
}

func main() {
    print("Testing extractBracketed...")
    let testStr = "[hello world]"
    print("Input: " + testStr)
    let extracted = extractBracketed(testStr, 0)
    print("Extracted: " + extracted)
}
