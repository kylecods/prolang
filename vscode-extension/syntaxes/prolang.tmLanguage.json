{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ProLang",
  "scopeName": "source.prolang",
  "fileTypes": [
    "prl",
    "prolang"
  ],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#calls" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.prolang",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.prolang",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.prolang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "comment": "A quotation mark is escaped by doubling it, as the lexer's ReadString does.",
              "name": "constant.character.escape.prolang",
              "match": "\"\""
            }
          ]
        }
      ]
    },
    "declarations": {
      "comment": "The name being declared, so a definition reads differently from a use.",
      "patterns": [
        {
          "match": "\\b(func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.prolang" },
            "2": { "name": "entity.name.function.prolang" }
          }
        },
        {
          "match": "\\b(struct|enum)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.prolang" },
            "2": { "name": "entity.name.type.prolang" }
          }
        },
        {
          "match": "\\b(global)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.variable.prolang" },
            "2": { "name": "variable.other.prolang" }
          }
        },
        {
          "match": "\\b(import)\\s+(\"[^\"]*\")",
          "captures": {
            "1": { "name": "keyword.control.import.prolang" },
            "2": { "name": "string.quoted.double.prolang" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.prolang",
          "match": "\\b(if|elif|else|while|for|to|break|continue|return)\\b"
        },
        {
          "name": "keyword.declaration.prolang",
          "match": "\\b(let|global|func|struct|enum|import)\\b"
        },
        {
          "name": "keyword.operator.cast.prolang",
          "match": "\\bas\\b"
        },
        {
          "name": "constant.language.prolang",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "comment": "Every name in TypeSymbol.Primitives, which is what the binder resolves.",
          "name": "support.type.prolang",
          "match": "\\b(int|int8|int16|int64|uint8|uint16|uint32|uint64|float|float32|float64|bool|string|void|any|array|map)\\b"
        },
        {
          "comment": "A capitalised name in a type position: struct and enum names by convention.",
          "match": "(?<=:\\s{0,8})([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.type.prolang" }
          }
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.prolang" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.prolang",
          "match": "(==|!=|<=|>=)"
        },
        {
          "name": "keyword.operator.assignment.prolang",
          "match": "(\\+=|-=|\\*=|/=|\\^=)"
        },
        {
          "name": "keyword.operator.logical.prolang",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.bitwise.prolang",
          "match": "(<<|>>|&|\\||~|\\^)"
        },
        {
          "name": "keyword.operator.arithmetic.prolang",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.assignment.prolang",
          "match": "(=)"
        },
        {
          "name": "keyword.operator.accessor.prolang",
          "match": "(\\.)"
        },
        {
          "name": "punctuation.separator.prolang",
          "match": "(,|:|;)"
        },
        {
          "name": "punctuation.bracket.prolang",
          "match": "(\\[|\\]|\\{|\\}|\\(|\\))"
        },
        {
          "name": "keyword.operator.relational.prolang",
          "match": "(<|>)"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "comment": "Hexadecimal, binary and octal, all of which the lexer accepts.",
          "name": "constant.numeric.integer.prolang",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b|\\b0[bB][01_]+\\b|\\b0[oO][0-7_]+\\b"
        },
        {
          "comment": "A float, with the f, f32 and f64 suffixes the lexer accepts.",
          "name": "constant.numeric.float.prolang",
          "match": "\\b\\d+\\.\\d+(f32|f64|f)?\\b|\\b\\d+(f32|f64|f)\\b"
        },
        {
          "name": "constant.numeric.integer.prolang",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.prolang",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
