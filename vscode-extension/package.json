{
  "name": "prolang",
  "displayName": "ProLang",
  "description": "Language support for ProLang, backed by the ProLang compiler itself",
  "version": "0.2.0",
  "publisher": "prolang-team",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "prolang",
    "programming language"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/prolang/prolang.git"
  },
  "activationEvents": [
    "onLanguage:prolang",
    "workspaceContains:**/*.prl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "prolang",
        "aliases": [
          "ProLang",
          "prolang"
        ],
        "extensions": [
          ".prl",
          ".prolang"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/prolang-icon.png",
          "dark": "./icons/prolang-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "prolang",
        "scopeName": "source.prolang",
        "path": "./syntaxes/prolang.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "prolang",
        "path": "./snippets/prolang.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "ProLang",
      "properties": {
        "prolang.serverPath": {
          "scope": "window",
          "type": "string",
          "default": "",
          "description": "Path to the prolang compiler, which also runs the language server. Empty searches PROLANG_PATH, then the ProLang repository if one is open, then PATH."
        },
        "prolang.stdPath": {
          "scope": "window",
          "type": "string",
          "default": "",
          "description": "Directory to resolve library imports from. Empty uses the std directory beside the compiler, unless the ProLang repository is open, in which case its own std is used."
        },
        "prolang.trace.server": {
          "scope": "window",
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "description": "Traces the messages exchanged with the language server."
        }
      }
    },
    "commands": [
      {
        "command": "prolang.runFile",
        "title": "Run File",
        "category": "ProLang"
      },
      {
        "command": "prolang.buildFile",
        "title": "Build File",
        "category": "ProLang"
      },
      {
        "command": "prolang.restartServer",
        "title": "Restart Language Server",
        "category": "ProLang"
      },
      {
        "command": "prolang.showServerInfo",
        "title": "Show Language Server Info",
        "category": "ProLang"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == prolang",
          "command": "prolang.runFile",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "typescript": "^5.1.6",
    "@vscode/vsce": "^2.20.0"
  }
}
