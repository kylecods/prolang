TARGET = prolang-csharp-runtime
.DEFAULT_GOAL := all
OBJS = runtime.o
RUNTIME_DIR ?= ../../../runtime/mips-cs/psp
OPT ?= -O3
CFLAGS = $(OPT) -G0 -std=gnu11 -fwrapv -ffunction-sections -fdata-sections -fno-strict-aliasing
CFLAGS += -I$(RUNTIME_DIR)
ASFLAGS = $(CFLAGS)
LDFLAGS = -Wl,--gc-sections
LIBS = -lpspgu -lpspge -lpspdisplay -lpspctrl -lm
BUILD_PRX = 1
EXTRA_TARGETS = EBOOT.PBP
PSP_EBOOT_TITLE = ProLang CSharp IL JIT
PSPSDK := $(shell psp-config --pspsdk-path)
runtime.o: $(RUNTIME_DIR)/host.h $(RUNTIME_DIR)/entry.h $(RUNTIME_DIR)/../../psp-v/host.h $(RUNTIME_DIR)/../../psp-v/gc.h
include $(PSPSDK)/lib/build.mak
